export struct CharacterPresets { reply: string, react: string, initiate: string, split: bool }

export struct PresetItem { id: string, name: string, model: string, provider: string, endpoint: string, key-env: string, temperature: string, tokens: string, timeout: string }
export struct PresetTemplateItem { id: string, name: string, icon: string, format: string, endpoint: string, documentation: string, badge: string, available: bool }
export global SettingsUi {
    in-out property <int> section;
    in-out property <[PresetItem]> settings-presets;
    in-out property <[PresetTemplateItem]> preset-templates;
    in-out property <string> preset-search;
    in-out property <int> preset-tab;
    in-out property <bool> preset-creating;
    in-out property <string> preset-template-id;
    in-out property <string> preset-template-name;
    in-out property <string> preset-provider-icon;
    in-out property <string> preset-schema-label;
    in-out property <string> preset-delete-id;
    in-out property <bool> preset-reserve-keys-open;
    in-out property <bool> preset-reserve-providers-open;
    in-out property <string> settings-error;
    in-out property <string> settings-revision;
    in-out property <int> settings-persistence;
    in-out property <string> settings-active;
    in-out property <int> settings-volume;
    in-out property <bool> settings-voice-launcher;
    in-out property <bool> settings-voice-game;
    in-out property <string> settings-voice-name;
    in-out property <[CharacterPresets]> character-presets;
    in-out property <int> selected-character;
    in-out property <bool> character-prompt-expanded: true;
    in-out property <string> preset-edit-id;
    in-out property <string> preset-save-token;
    in-out property <string> preset-name;
    in-out property <string> preset-model;
    in-out property <string> preset-endpoint;
    in-out property <string> preset-key-env;
    in-out property <string> preset-temperature;
    in-out property <string> preset-tokens;
    in-out property <string> preset-timeout;
    public pure function matches-preset(item: PresetItem, query: string) -> bool {
        return query == "" || item.name.to-lowercase().replace-all(query.to-lowercase(), "") != item.name.to-lowercase() || item.model.to-lowercase().replace-all(query.to-lowercase(), "") != item.model.to-lowercase();
    }
    callback preset-new();
    callback preset-template-select(string);
    callback preset-save();
    callback preset-edit(string);
    callback preset-delete(string);
    callback preset-activate(string);
    callback character-preset(int, int, string);
    callback character-common(int, string);
    callback voice-launcher(bool);
    callback voice-game(bool);
    callback voice-name(string);
    callback volume(int);
}
