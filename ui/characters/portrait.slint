import { CharacterCatalog } from "catalog.slint";
import { Avatar } from "../components/avatar.slint";

export component CharacterPortrait inherits Rectangle {
    in property <int> character;
    in property <color> surface;
    if CharacterCatalog.entries[root.character].has-avatar: Avatar {
        width: parent.width; height: parent.height;
        source: CharacterCatalog.entries[root.character].avatar;
        surface: root.surface;
    }
    if !CharacterCatalog.entries[root.character].has-avatar: Rectangle {
        width: parent.width; height: parent.height;
        border-radius: min(self.width, self.height) / 2;
        background: #ff80bf;
        Text { width: 100%; height: 100%; text: CharacterCatalog.entries[root.character].initial; color: #090915; font-family: "Segoe UI"; font-size: parent.height / 2; vertical-alignment: center; horizontal-alignment: center; }
    }
}
