import { I18n } from "../i18n.slint";

export struct CharacterOption { index: int, id: string, name: string, conversation-name: string, avatar: image, has-avatar: bool, initial: string }

export global CharacterCatalog {
    property <image> empty-avatar;
    out property <[CharacterOption]> entries: [
        {index: 0, id: "Crazy", name: I18n.i18n("character.crazy", "Безумная Мита"), conversation-name: I18n.i18n("character.crazy.with", "Безумной Митой"), avatar: @image-url("../../assets/avatars/crazy.png"), has-avatar: true, initial: "C"},
        {index: 1, id: "Kind", name: I18n.i18n("character.kind", "Добрая Мита"), conversation-name: I18n.i18n("character.kind.with", "Доброй Митой"), avatar: @image-url("../../assets/avatars/kind.png"), has-avatar: true, initial: "K"},
        {index: 2, id: "Cappie", name: I18n.i18n("character.cappie", "Кепочка"), conversation-name: I18n.i18n("character.cappie.with", "Кепочкой"), avatar: @image-url("../../assets/avatars/cappie.png"), has-avatar: true, initial: "C"},
        {index: 3, id: "ShortHair", name: I18n.i18n("character.shorthair", "Коротковолосая Мита"), conversation-name: I18n.i18n("character.shorthair.with", "Коротковолосой Митой"), avatar: @image-url("../../assets/avatars/shorthair.png"), has-avatar: true, initial: "S"},
        {index: 4, id: "Mila", name: I18n.i18n("character.mila", "Мила"), conversation-name: I18n.i18n("character.mila.with", "Милой"), avatar: @image-url("../../assets/avatars/mila.png"), has-avatar: true, initial: "M"},
        {index: 5, id: "Sleepy", name: I18n.i18n("character.sleepy", "Сонная Мита"), conversation-name: I18n.i18n("character.sleepy.with", "Сонной Митой"), avatar: @image-url("../../assets/avatars/sleepy.png"), has-avatar: true, initial: "S"},
        {index: 6, id: "Ghost", name: I18n.i18n("character.ghost", "Призрачная Мита"), conversation-name: I18n.i18n("character.ghost.with", "Призрачной Митой"), avatar: @image-url("../../assets/avatars/ghost.png"), has-avatar: true, initial: "G"},
        {index: 7, id: "Creepy", name: I18n.i18n("character.creepy", "Жуткая Мита"), conversation-name: I18n.i18n("character.creepy.with", "Жуткой Митой"), avatar: CharacterCatalog.empty-avatar, has-avatar: false, initial: "C"},
        {index: 8, id: "GameMaster", name: I18n.i18n("character.gamemaster", "Мастер игры"), conversation-name: I18n.i18n("character.gamemaster.with", "Мастером игры"), avatar: CharacterCatalog.empty-avatar, has-avatar: false, initial: "G"}
    ];
    public pure function matches(entry: CharacterOption, query: string) -> bool {
        return query == "" || entry.name.to-lowercase().replace-all(query.to-lowercase(), "") != entry.name.to-lowercase() || entry.id.to-lowercase().replace-all(query.to-lowercase(), "") != entry.id.to-lowercase();
    }
}
