import { SettingsTheme } from "../settings/theme.slint";
import { SettingsText, SettingsGlyph, SettingsTextField } from "settings-kit.slint";
import { ActionSurface } from "controls.slint";
import { CharacterCatalog } from "../characters/catalog.slint";
import { CharacterPortrait } from "../characters/portrait.slint";
import { I18n } from "../i18n.slint";

component VoiceTab inherits ActionSurface {
    in property <bool> all-characters;
    in property <int> character;
    label: root.all-characters ? I18n.i18n("voice.api.default-voice", "Общий голос") : CharacterCatalog.name(CharacterCatalog.entries[root.character]);
    width: 88px;
    height: 80px;
    horizontal-stretch: 0;
    border-radius: 16px;
    border-width: root.selected ? 1.5px : 0px;
    border-color: root.selected ? SettingsTheme.accent : transparent;
    background: root.selected ? SettingsTheme.panel : self.hovered ? SettingsTheme.button-hover : SettingsTheme.field;

    VerticalLayout {
        padding: 11px;
        spacing: 0px;
        alignment: center;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: SettingsTheme.field;
            border-color: root.selected ? SettingsTheme.accent : transparent;
            border-width: root.selected ? 2px : 0px;
            if root.all-characters: SettingsGlyph {
                text: "\u{f0c0}";
                width: 100%;
                height: 100%;
                font-size: 30px;
                color: SettingsTheme.muted;
            }
            if !root.all-characters: VerticalLayout {
                padding: 2px;
                spacing: 0px;
                alignment: center;
                CharacterPortrait {
                    width: 50px;
                    height: 50px;
                    character: root.character;
                    surface: SettingsTheme.panel;
                }
            }
        }
    }
}

component VoiceScrollButton inherits ActionSurface {
    in property <string> glyph;
    width: 29px;
    height: 32px;
    label: glyph;
    border-radius: 10px;
    border-width: root.enabled ? 1px : 0px;
    border-color: SettingsTheme.border;
    background: root.enabled ? (self.hovered ? SettingsTheme.button-hover : SettingsTheme.field) : transparent;
    SettingsGlyph {
        width: parent.width;
        height: parent.height;
        text: root.glyph;
        font-size: 13px;
        color: root.enabled ? SettingsTheme.text : SettingsTheme.muted;
    }
}

export component CharacterVoiceTabs inherits VerticalLayout {
    in property <int> selected;
    in-out property <int> offset;
    in-out property <string> voice-id;
    callback changed-id(int, string);
    callback changed-selection(int);
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    padding: 0px;
    spacing: 0px;

    SettingsText {
        text: I18n.i18n("voice.api.characters", "Голоса персонажей");
        height: 27px;
        font-size: 13px;
        font-weight: 700;
    }

    HorizontalLayout {
        spacing: 6px;
        height: 82px;
        padding: 0px;
        vertical-stretch: 0;
        viewport := Flickable {
            height: 82px;
            horizontal-stretch: 1;
            min-width: 0px;
            preferred-width: 0px;
            content-height: 82px;
            content-width: (CharacterCatalog.entries.length + 1) * 96px;
            content-x: clamp(-root.offset * 96px, min(0px, self.width - self.content-width), 0px);
            mouse-drag-pan-enabled: false;

            tabs := HorizontalLayout {
                width: (CharacterCatalog.entries.length + 1) * 96px;
                height: 82px;
                spacing: 8px;
                padding: 0px;
                VoiceTab {
                    all-characters: true;
                    selected: root.selected == -1;
                    activated => { root.changed-selection(-1); root.offset = 0; }
                }
                for entry[index] in CharacterCatalog.entries: VoiceTab {
                    character: entry.index;
                    selected: root.selected == entry.index;
                    activated => {
                        root.changed-selection(entry.index);
                        if (index + 1 < root.offset) { root.offset = index + 1; }
                        if ((index + 2) * 96px > -viewport.content-x + viewport.width) {
                            root.offset = max(0, index - 2);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            width: 65px;
            spacing: 6px;
            alignment: center;
            VoiceScrollButton {
                glyph: "\u{f053}";
                enabled: root.offset > 0;
                activated => { root.offset = max(0, root.offset - 2); }
            }
            VoiceScrollButton {
                glyph: "\u{f054}";
                enabled: -viewport.content-x + viewport.width < viewport.content-width - 1px;
                activated => { root.offset = min(CharacterCatalog.entries.length, root.offset + 2); }
            }
        }
    }
    Rectangle {
        height: 125px;
        vertical-stretch: 0;
        background: SettingsTheme.panel;
        border-color: SettingsTheme.border;
        border-width: 1px;
        border-radius: 17px;
        VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 12px;
            padding-bottom: 13px;
            spacing: 7px;
            SettingsText {
                text: root.selected == -1 ? I18n.i18n("voice.api.default-voice", "Общий голос") : root.selected >= 0 && root.selected < CharacterCatalog.entries.length ? CharacterCatalog.name(CharacterCatalog.entries[root.selected]) : I18n.i18n("voice.api.unknown", "Не выбран");
                font-weight: 700;
                font-size: 13px;
                height: 18px;
            }
            SettingsText {
                text: I18n.i18n("voice.api.voice-catalog", "Где искать голос? Каталог провайдера");
                font-size: 11px;
                height: 18px;
                color: SettingsTheme.accent;
            }
            HorizontalLayout {
                height: 38px;
                spacing: 8px;
                SettingsTextField {
                    value <=> root.voice-id;
                    placeholder: I18n.i18n("voice.api.voice-id", "Идентификатор голоса");
                    horizontal-stretch: 1;
                    accepted(value) => { root.changed-id(root.selected, value); }
                }
                ActionSurface {
                    label: I18n.i18n("voice.api.voice-catalog", "Где искать голос? Каталог провайдера");
                    width: 40px;
                    height: 38px;
                    enabled: false;
                    background: SettingsTheme.button;
                    border-width: 1px;
                    border-color: SettingsTheme.border;
                    border-radius: 10px;
                    SettingsGlyph {
                        text: "\u{f002}";
                        width: 100%;
                        height: 100%;
                        color: SettingsTheme.muted;
                    }
                }
            }
        }
    }
}
