import { Fa } from "../sandbox/theme.slint";
import { Caption, Glyph, Centered } from "../sandbox/controls.slint";
import { ActionSurface } from "controls.slint";
import { SettingsTheme } from "../settings/theme.slint";

export component CollapsibleSettingsSection inherits Rectangle {
    in property <string> title;
    in property <string> glyph;
    in-out property <bool> expanded;
    in property <bool> danger;
    background: SettingsTheme.section;
    border-radius: SettingsTheme.section-radius;
    border-width: 1px;
    border-color: root.danger ? SettingsTheme.danger-border : SettingsTheme.border;
    vertical-stretch: 0;

    VerticalLayout {
        spacing: 0px; padding: 1px;
        header := ActionSurface {
            label: root.title;
            height: SettingsTheme.section-header-height - 2px;
            vertical-stretch: 0;
            border-radius: SettingsTheme.section-radius - 1px;
            border-bottom-left-radius: root.expanded ? 0px : self.border-radius;
            border-bottom-right-radius: root.expanded ? 0px : self.border-radius;
            border-width: 0px;
            background: self.pressed ? SettingsTheme.header-pressed : self.hovered ? SettingsTheme.header-hover : transparent;
            activated => { root.expanded = !root.expanded; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                Centered { width: 26px; Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 9px;
                    background: SettingsTheme.icon-background;
                    border-width: 1px;
                    border-color: SettingsTheme.icon-border;
                    Glyph { width: 100%; height: 100%; text: root.glyph; font-size: 14px; color: SettingsTheme.icon; }
                } }
                Caption { text: root.title; horizontal-stretch: 1; font-family: SettingsTheme.font-family; font-size: 12px; font-weight: 800; }
                Glyph { text: root.expanded ? Fa.down : "\u{f054}"; width: 18px; font-size: 13px; color: SettingsTheme.arrow; }
            }
        }
        Rectangle {
            visible: root.expanded;
            min-height: 0px;
            max-height: root.expanded ? 100000px : 0px;
            clip: true;
            vertical-stretch: 0;
            background: SettingsTheme.section-content;
            border-bottom-left-radius: SettingsTheme.section-radius - 1px;
            border-bottom-right-radius: SettingsTheme.section-radius - 1px;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 16px;
                spacing: 10px;
                @children
            }
        }
    }
}
