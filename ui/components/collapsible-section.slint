import { SandboxTheme, Fa } from "../sandbox/theme.slint";
import { Caption, Glyph } from "../sandbox/controls.slint";
import { ActionSurface } from "controls.slint";

export component CollapsibleSettingsSection inherits Rectangle {
    in property <string> title;
    in property <string> glyph;
    in-out property <bool> expanded;
    in property <bool> danger;
    background: SandboxTheme.panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.danger ? #963b57 : SandboxTheme.border;
    vertical-stretch: 0;

    VerticalLayout {
        spacing: 0px;
        header := ActionSurface {
            label: root.title;
            height: 50px;
            vertical-stretch: 0;
            border-radius: 10px;
            border-width: 0px;
            background: self.pressed ? #ffffff0e : self.hovered ? #ffffff08 : transparent;
            activated => { root.expanded = !root.expanded; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 9px;
                    background: #b74b7d1a;
                    border-width: 1px;
                    border-color: #b74b7d33;
                    Glyph { width: 100%; height: 100%; text: root.glyph; font-size: 14px; color: SandboxTheme.icon; }
                }
                Caption { text: root.title; horizontal-stretch: 1; font-size: 13px; font-weight: 800; }
                Glyph { text: root.expanded ? Fa.down : "\u{f054}"; width: 18px; font-size: 13px; color: #ff9ed3; }
            }
        }
        if root.expanded: Rectangle {
            vertical-stretch: 0;
            background: #0809136b;
            border-radius: 10px;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 16px;
                spacing: 10px;
                @children
            }
        }
    }
}
