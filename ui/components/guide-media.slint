// Guide image geometry, normalized focus overlay and native screenshot crops.

export struct GuideFocusTarget {
    number: int,
    left: float,
    top: float,
    width: float,
    height: float,
}

export component GuideMedia inherits Rectangle {
    in property <string> image-key;
    in property <string> language;
    in property <string> description;
    in property <float> zoom: 1.0;
    in property <int> sizing-mode: 0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <float> crop-left: 0.0;
    in property <float> crop-top: 0.0;
    in property <float> crop-right: 1.0;
    in property <float> crop-bottom: 1.0;
    in property <[GuideFocusTarget]> steps;
    in property <int> focus-step: 0;
    in property <float> focus-center-x: 0.5;
    in property <float> focus-center-y: 0.5;

    private property <image> picture:
        root.image-key == "welcome" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_welcome.png") : @image-url("../../assets/guide/guide_welcome1.png")) :
        root.image-key == "preset" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_preset.png") : @image-url("../../assets/guide/guide_preset1.png")) :
        root.image-key == "voice" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_voice.png") : @image-url("../../assets/guide/guide_voice1.png")) :
        root.image-key == "microphone" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_microphone.png") : @image-url("../../assets/guide/guide_microphone1.png")) :
        root.image-key == "memory" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_memory.png") : @image-url("../../assets/guide/guide_memory1.png")) :
        root.image-key == "screen" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_screen.png") : @image-url("../../assets/guide/guide_screen1.png")) :
        root.image-key == "models" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_models.png") : @image-url("../../assets/guide/guide_models1.png")) :
        root.image-key == "sandbox" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_sandbox.png") : @image-url("../../assets/guide/guide_sandbox1.png")) :
        root.image-key == "next" ? (root.language == "ru" ? @image-url("../../assets/guide/guide_next.png") : @image-url("../../assets/guide/guide_next1.png")) :
        @image-url("");

    private property <float> cropped-width: max(1.0, (root.picture.width) * (root.crop-right - root.crop-left));
    private property <float> cropped-height: max(1.0, (root.picture.height) * (root.crop-bottom - root.crop-top));
    private property <float> crop-ratio: root.cropped-width / root.cropped-height;
    private property <length> fitted-width: min(root.width, root.height * root.crop-ratio);
    private property <length> fitted-height: min(root.height, root.width / root.crop-ratio);
    private property <length> base-width: root.sizing-mode == 1 ? root.width :
        root.sizing-mode == 2 ? 1px * root.cropped-width : root.fitted-width;
    private property <length> base-height: root.base-width / root.crop-ratio;

    background: #090c16;
    clip: true;

    snapshot := Image {
        source: root.picture;
        source-clip-x: ((root.picture.width) * root.crop-left);
        source-clip-y: ((root.picture.height) * root.crop-top);
        source-clip-width: max(1, ((root.picture.width) * (root.crop-right - root.crop-left)));
        source-clip-height: max(1, ((root.picture.height) * (root.crop-bottom - root.crop-top)));
        image-fit: fill;
        accessible-label: root.description;
        width: root.base-width * root.zoom;
        height: root.base-height * root.zoom;
        x: self.width <= root.width ? (root.width - self.width) / 2
           : max(root.width - self.width, min(0px, root.width / 2 - self.width * root.focus-center-x + root.pan-x));
        y: self.height <= root.height ? (root.height - self.height) / 2
           : max(root.height - self.height, min(0px, root.height / 2 - self.height * root.focus-center-y + root.pan-y));
    }

    TouchArea {
        enabled: snapshot.width > root.width || snapshot.height > root.height;
        private property <length> drag-start-pan-x;
        private property <length> drag-start-pan-y;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.drag-start-pan-x = root.pan-x;
                self.drag-start-pan-y = root.pan-y;
            }
        }
        moved => {
            root.pan-x = self.drag-start-pan-x + self.mouse-x - self.pressed-x;
            root.pan-y = self.drag-start-pan-y + self.mouse-y - self.pressed-y;
        }
    }

    for step in root.steps: Rectangle {
        visible: step.number == root.focus-step;
        x: snapshot.x + snapshot.width * step.left;
        y: snapshot.y + snapshot.height * step.top;
        width: snapshot.width * step.width;
        height: snapshot.height * step.height;
        background: #de4c912a;
        border-width: 2px;
        border-color: #ee5b9de6;
        border-radius: 5px;
    }
}
