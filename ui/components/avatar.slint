export component Avatar inherits Rectangle {
    in property <image> source;
    in property <color> surface;
    width: 34px; height: 34px;
    Image { source: root.source; width: 100%; height: 100%; image-fit: contain; image-rendering: smooth; }
    Image { source: @image-url("avatar-mask.svg"); width: 100%; height: 100%; colorize: root.surface; image-rendering: smooth; }
}
