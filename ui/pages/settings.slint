import { SettingsSectionHeading, SettingsToggleRow, SettingsRow, SettingsText, SettingsEntryRow, SettingsChoiceRow, SettingsNumberRow, SettingsButtonRow } from "../components/settings-kit.slint";
import { CharacterCatalog } from "../characters/catalog.slint";
import { CharacterPortrait } from "../characters/portrait.slint";
import { SettingsTheme } from "../settings/theme.slint";
import { SettingsScrollView } from "../settings/scroll-view.slint";
import { MemoryUi, MemoryPanel } from "../sandbox/memory.slint";
import { VolumeSlider } from "../components/volume-slider.slint";
import { ScrollView } from "std-widgets.slint";
import { SandboxTheme, Fa } from "../sandbox/theme.slint";
import { Caption, Glyph, HeaderButton, QuickAction, Centered, Field, Toggle, StyledCheckbox } from "../sandbox/controls.slint";
import { ActionSurface } from "../components/controls.slint";
import { CollapsibleSettingsSection } from "../components/collapsible-section.slint";
import { I18n } from "../i18n.slint";
import { LanguageSettingsPage } from "../settings/language-page.slint";

export struct CharacterPresets { reply: string, react: string, initiate: string, split: bool }

export struct PresetItem { id: string, name: string, model: string, endpoint: string, key-env: string, temperature: string, tokens: string, timeout: string }
export global SettingsUi {
    in-out property <int> section;
    in-out property <[bool]> section-visible: [true, true, true, true, true, true, true, true, true, true, true, true];
    in-out property <bool> hide-private: true;
    callback section-visibility(int, bool);
    callback set-hide-private(bool);
    in-out property <[PresetItem]> settings-presets;
    in-out property <string> settings-error;
    in-out property <string> settings-revision;
    in-out property <int> settings-persistence;
    in-out property <string> settings-active;
    in-out property <int> settings-volume;
    in-out property <bool> settings-voice-launcher;
    in-out property <bool> settings-voice-game;
    in-out property <string> settings-voice-name;
    in-out property <[CharacterPresets]> character-presets;
    in-out property <int> selected-character;
    in-out property <bool> character-prompt-expanded: true;
    in-out property <string> preset-edit-id;
    in-out property <string> preset-save-token;
    in-out property <string> preset-name;
    in-out property <string> preset-model;
    in-out property <string> preset-endpoint: "https://generativelanguage.googleapis.com/v1beta/";
    in-out property <string> preset-key-env: "GEMINI_API_KEY";
    in-out property <string> preset-temperature: "0.7";
    in-out property <string> preset-tokens: "3000";
    in-out property <string> preset-timeout: "60000";
    callback preset-save();
    callback preset-edit(string);
    callback preset-delete(string);
    callback preset-activate(string);
    callback character-preset(int, int, string);
    callback character-common(int, string);
    callback voice-launcher(bool);
    callback voice-game(bool);
    callback voice-name(string);
    callback volume(int);
}

component Card inherits Rectangle {
    background: SettingsTheme.canvas; border-radius: 14px; border-width: 1px; border-color: SettingsTheme.border;
    @children
}

component SettingsLabel inherits Caption { font-family: SettingsTheme.font-family; }
component SettingsField inherits Field {
    font-family: SettingsTheme.font-family;
    background: SettingsTheme.field;
    border-color: root.focused ? SettingsTheme.field-focus-border : SettingsTheme.field-border;
    border-radius: 10px;
}
component SettingsButton inherits HeaderButton {
    font-family: SettingsTheme.font-family;
    font-weight: 700;
    horizontal-padding: 16px;
    background: root.selected ? SettingsTheme.accent : self.pressed ? SettingsTheme.button-pressed : self.hovered ? SettingsTheme.button-hover : SettingsTheme.button;
    border-color: self.hovered ? SettingsTheme.button-hover-border : SettingsTheme.button-border;
}

component EditorField inherits VerticalLayout {
    in property <string> title;
    in-out property <string> text;
    height: 64px; spacing: 6px; padding: 0px;
    SettingsLabel { text: root.title; font-size: 12px; color: SettingsTheme.muted; }
    SettingsField { text <=> root.text; height: 40px; }
}

component SectionHeading inherits SettingsSectionHeading {}

component PresetChoice inherits Rectangle {
    in property <string> value;
    callback selected(string);
    height: 40px; min-width: 0px; background: SettingsTheme.field; border-width: 1px; border-color: SettingsTheme.field-border; border-radius: 10px;
    HorizontalLayout { padding-left: 12px; padding-right: 10px; spacing: 8px;
        SettingsLabel { text: root.value == "" ? I18n.i18n("settings.preset.unset", "Не выбран") : root.value == "active" ? I18n.i18n("settings.preset.active", "Активный пресет") + " (#" + SettingsUi.settings-active + ")" : "#" + root.value; horizontal-stretch: 1; }
        Glyph { text: "\u{f077}"; font-size: 11px; color: SettingsTheme.accent; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow { y: root.height + 3px; width: root.width; height: min(300px, (SettingsUi.settings-presets.length + 1) * 34px + 8px); close-policy: close-on-click-outside;
        Rectangle { width: 100%; height: 100%; background: SettingsTheme.popup; border-radius: 9px; border-width: 1px; border-color: SettingsTheme.border;
            ScrollView { width: 100%; height: 100%; content-width: self.visible-width;
                VerticalLayout { padding: 4px; spacing: 2px; alignment: start;
                    QuickAction { text: I18n.i18n("settings.preset.active", "Активный пресет"); activated => { root.selected("active"); menu.close(); } }
                    for preset in SettingsUi.settings-presets: QuickAction { text: "#" + preset.id + " · " + preset.name; activated => { root.selected(preset.id); menu.close(); } }
                }
            }
        }
    }
}


component CharacterWorkspace inherits HorizontalLayout {
    in property <bool> connected;
    in-out property <int> character;
    in-out property <string> search;
    in-out property <bool> prompt-expanded: true;
    in-out property <bool> provider-expanded;
    in-out property <bool> maintenance-expanded;
    in-out property <bool> danger-expanded;
    spacing: 9px;
    property <CharacterPresets> presets: SettingsUi.character-presets[root.character];
    Rectangle {
        width: max(240px, (parent.width - 9px) / 4);
        background: SettingsTheme.panel; border-width: 1px; border-color: SettingsTheme.border; border-radius: 12px;
        VerticalLayout {
            padding: 10px; spacing: 6px;
            HorizontalLayout {
                height: 20px;
                SettingsLabel { text: I18n.i18n("settings.characters.library", "Библиотека персонажей"); font-size: 14px; font-weight: 600; horizontal-stretch: 1; }
                SettingsLabel { text: "" + CharacterCatalog.entries.length; color: SettingsTheme.muted; }
            }
            SettingsField { text <=> root.search; placeholder: I18n.i18n("settings.characters.search", "Поиск персонажей…"); leading-glyph: "\u{f002}"; height: 38px; border-radius: 10px; }
            Rectangle {
                background: SettingsTheme.field; border-width: 1px; border-color: SettingsTheme.field-border; border-radius: 10px;
                vertical-stretch: 1;
                VerticalLayout { padding-left: 10px; padding-right: 10px; padding-top: 7px; padding-bottom: 7px;
                ScrollView {
                content-width: self.visible-width;
                VerticalLayout {
                    padding: 3px; spacing: 0px; alignment: start;
                    for entry in CharacterCatalog.entries: VerticalLayout { padding: 0px; spacing: 0px; vertical-stretch: 0;
                    if CharacterCatalog.matches(entry, root.search): ActionSurface {
                        height: 48px; label: entry.name;
                        selected: root.character == entry.index; border-radius: 9px; border-width: 1px;
                        border-color: self.selected || self.hovered ? SettingsTheme.selected-border : SettingsTheme.item-border;
                        background: SettingsTheme.panel;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 7px; spacing: 10px;
                            Centered { width: 32px; CharacterPortrait { width: 32px; height: 32px; character: entry.index; surface: SettingsTheme.panel; } }
                            VerticalLayout {
                                padding: 0px; spacing: 2px; alignment: center;
                                SettingsLabel { text: entry.name; font-weight: 700; }
                                SettingsLabel { text: "id: " + entry.id; color: SettingsTheme.muted; font-size: 11px; }
                            }
                        }
                        activated => { root.character = entry.index; if (root.connected) { MemoryUi.select(entry.index); } }
                    }
                    if CharacterCatalog.matches(entry, root.search): Rectangle { height: 6px; }
                    }
                }
                }
                }
            }
        }
    }
    Rectangle {
        min-width: 350px; horizontal-stretch: 1;
        background: SettingsTheme.panel; border-width: 1px; border-color: SettingsTheme.border; border-radius: 12px;
        VerticalLayout {
            padding: 12px; spacing: 14px;
            HorizontalLayout {
                height: 56px; spacing: 14px;
                Centered { width: 56px; CharacterPortrait {
                    width: 56px; height: 56px;
                    character: root.character;
                    surface: SettingsTheme.panel;
                } }
                VerticalLayout {
                    padding: 0px; spacing: 2px; alignment: center;
                    SettingsLabel {
                        text: CharacterCatalog.entries[root.character].name;
                        font-size: 20px; font-weight: 700;
                    }
                    SettingsLabel { text: "id: " + CharacterCatalog.entries[root.character].id; color: SettingsTheme.muted; }
                }
            }
            SettingsScrollView {
                vertical-stretch: 1;
                content-height: sections.preferred-height;
                sections := VerticalLayout {
                    width: parent.width;
                    padding: 0px; spacing: 12px; alignment: start;
                    CollapsibleSettingsSection { title: I18n.i18n("settings.characters.prompt-set", "Набор промптов"); glyph: "\u{f15c}"; expanded <=> root.prompt-expanded;
VerticalLayout {
                            padding: 0px; spacing: 12px;
                            SettingsField {
                                placeholder: I18n.i18n("settings.characters.prompt-unavailable", "Каталог наборов промптов не подключён");
                                enabled: false; height: 38px;
                                Glyph { x: parent.width - 28px; width: 18px; height: parent.height; text: "\u{f077}"; font-size: 11px; color: SettingsTheme.accent; }
                            }
                            VerticalLayout {
                                padding: 0px; spacing: 4px;
                                HorizontalLayout { height: 20px; spacing: 8px;
                                    SettingsLabel { text: I18n.i18n("settings.characters.author", "Автор:"); font-weight: 600; }
                                    SettingsLabel { text: "—"; horizontal-stretch: 1; }
                                }
                                HorizontalLayout { height: 20px; spacing: 8px;
                                    SettingsLabel { text: I18n.i18n("settings.characters.version", "Версия:"); font-weight: 600; }
                                    SettingsLabel { text: "—"; horizontal-stretch: 1; }
                                }
                                SettingsLabel { text: I18n.i18n("settings.characters.prompt-description", "Описание:"); font-weight: 600; }
                                SettingsLabel { text: "—"; }
                            }
                            HorizontalLayout { spacing: 6px;
                                SettingsButton { text: I18n.i18n("settings.characters.open-prompt-folder", "Открыть папку набора"); glyph: "\u{f07c}"; enabled: false; horizontal-stretch: 1; height: 34px; border-radius: 10px; }
                                SettingsButton { text: I18n.i18n("settings.characters.reload", "Перезагрузить"); glyph: Fa.refresh; enabled: false; horizontal-stretch: 1; height: 34px; border-radius: 10px; }
                            }
                        }
                    }
                    CollapsibleSettingsSection { title: I18n.i18n("settings.characters.provider", "Провайдер для персонажа"); glyph: "\u{f1e6}"; expanded <=> root.provider-expanded;
VerticalLayout {
                            padding: 0px; spacing: 8px;
                            SettingsLabel { text: I18n.i18n("settings.characters.provider-note", "Провайдер задаётся выбранным пресетом генерации."); color: SettingsTheme.muted; wrap: word-wrap; }
                            SettingsLabel { text: I18n.i18n("settings.characters.generation-presets", "Пресеты генерации"); font-size: 14px; font-weight: 700; }
                            StyledCheckbox {
                                text: I18n.i18n("settings.characters.split-presets", "Отдельные пресеты для разных видов генерации");
                                checked: root.presets.split;
                                enabled: root.connected;
                                toggled(value) => {
                                    if (value) { SettingsUi.character-presets[root.character].split = true; }
                                    else {
                                        if root.presets.reply == root.presets.react && root.presets.reply == root.presets.initiate { SettingsUi.character-presets[root.character].split = false; }
                                        SettingsUi.character-common(root.character, root.presets.reply);
                                    }
                                }
                            }
                            if !(root.presets.split): VerticalLayout {
                                padding: 0px; spacing: 6px;
                                SettingsLabel { text: I18n.i18n("settings.characters.generation-preset", "Пресет генерации"); color: SettingsTheme.muted; }
                                PresetChoice {
                                    value: root.presets.reply;
                                    selected(value) => {
                                        if (root.connected) {
                                            SettingsUi.character-common(root.character, value);
                                        }
                                    }
                                }
                            }
                            if (root.presets.split): VerticalLayout {
                                padding: 0px; spacing: 10px;
                                for title[index] in [I18n.i18n("settings.operation.reply", "Ответ на сообщение"), I18n.i18n("settings.operation.react", "Реакция на событие"), I18n.i18n("settings.operation.initiate", "Инициатива")]: VerticalLayout {
                                    padding: 0px; spacing: 5px;
                                    SettingsLabel { text: title; color: SettingsTheme.muted; }
                                    PresetChoice {
                                        value: index == 0 ? root.presets.reply : index == 1 ? root.presets.react : root.presets.initiate;
                                        selected(value) => { if (root.connected) { SettingsUi.character-preset(root.character, index, value); } }
                                    }
                                }
                            }
                        }
                    }
                    CollapsibleSettingsSection { title: I18n.i18n("settings.characters.history", "История персонажа и память"); glyph: "\u{f1da}"; expanded <=> MemoryUi.open;
VerticalLayout {
                        spacing: 8px;
                        SettingsLabel { text: I18n.i18n("settings.characters.history-actions", "Управляйте воспоминаниями этого персонажа."); color: SettingsTheme.muted; wrap: word-wrap; }
                        MemoryPanel { width: 100%; }
                     }
                    }
                    CollapsibleSettingsSection { title: I18n.i18n("settings.characters.maintenance", "Обслуживание"); glyph: Fa.gear; expanded <=> root.maintenance-expanded;
VerticalLayout {
                            padding: 0px; spacing: 8px;
                            SettingsLabel { text: I18n.i18n("settings.characters.maintenance-note", "Операции обслуживания пока недоступны."); color: SettingsTheme.muted; wrap: word-wrap; }
                        }
                    }
                    CollapsibleSettingsSection { title: I18n.i18n("settings.characters.danger", "Опасная зона — все персонажи"); glyph: "\u{f071}"; expanded <=> root.danger-expanded; danger: true;
VerticalLayout {
                            padding: 0px;
                            SettingsLabel { text: I18n.i18n("settings.characters.danger-note", "Глобальные операции удаления пока недоступны."); color: SettingsTheme.danger-text; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> connected;
    in property <bool> connecting;
    callback home();
    callback wiki();
    callback guide();
    callback language-selected(string);
    property <string> delete-id;
    in-out property <bool> general-sections-expanded: true;
    property <string> voice-draft: SettingsUi.settings-voice-name;
    background: SettingsTheme.canvas;
    VerticalLayout {
        padding-left: 28px; padding-right: 28px; padding-top: 24px; padding-bottom: 24px; spacing: 20px;
        HorizontalLayout { height: 57px; spacing: 18px; padding-left: 4px; padding-right: 4px;
            VerticalLayout { padding: 0px; alignment: center; spacing: 5px; horizontal-stretch: 1;
                HorizontalLayout { height: 32px; spacing: 10px;
                    Glyph { text: Fa.gear; color: SettingsTheme.hero-icon; width: 22px; font-size: 22px; }
                    SettingsLabel { text: I18n.i18n("page.settings.title", "Настройки"); font-family: SandboxTheme.font-family; font-size: 24px; font-weight: 800; horizontal-stretch: 1; }
                }
                SettingsLabel { text: I18n.i18n("settings.subtitle", "Все параметры NeuroMita в одном месте: персонажи, голос, модели ИИ, память и обновления."); color: SettingsTheme.muted; font-size: 12px; }
            }
            HorizontalLayout { spacing: 10px;
                Centered { SettingsButton { text: I18n.i18n("sandbox.header.guide", "Руководство"); activated => { root.guide(); } } }
                Centered { SettingsButton { text: I18n.i18n("sandbox.header.wiki", "Вики"); activated => { root.wiki(); } } }
                Centered { SettingsButton { text: I18n.i18n("sandbox.header.home", "На главную"); activated => { root.home(); } } }
                Centered { SettingsButton { text: I18n.i18n("settings.open-updates", "Открыть обновления"); background: @linear-gradient(90deg, SettingsTheme.primary-start, SettingsTheme.primary-end); activated => { SettingsUi.section = 10; } } }
            }
        }
        Rectangle { background: SettingsTheme.workspace; border-radius: SettingsTheme.panel-radius; border-width: 1px; border-color: SettingsTheme.border;
            VerticalLayout { padding: 14px; spacing: 14px;
                Rectangle { vertical-stretch: 0;
                FlexboxLayout { padding-left: 26px; padding-right: 0px; flex-wrap: wrap; spacing-horizontal: 5px; spacing-vertical: 6px; alignment: start; cross-axis-line-alignment: start;
                    for item in [
                        {section: 0, name: I18n.i18n("settings.general", "Общие"), icon: Fa.gear},
                        {section: 4, name: I18n.i18n("settings.language", "Язык"), icon: "\u{f0ac}"},
                        {section: 1, name: "API", icon: "\u{f1e6}"},
                        {section: 2, name: I18n.i18n("settings.characters", "Персонажи"), icon: "\u{f007}"},
                        {section: 3, name: I18n.i18n("settings.voice", "Озвучка"), icon: "\u{f028}"},
                        {section: 5, name: "ASR", icon: Fa.microphone},
                        {section: 6, name: I18n.i18n("settings.ai-engine", "ИИ-движок"), icon: "\u{f2db}"},
                        {section: 7, name: I18n.i18n("settings.game", "Игра"), icon: "\u{f11b}"},
                        {section: 8, name: I18n.i18n("settings.models", "Модели"), icon: "\u{f544}"},
                        {section: 9, name: I18n.i18n("settings.images", "Изображения"), icon: "\u{f03e}"},
                        {section: 10, name: I18n.i18n("settings.updates", "Обновления"), icon: "\u{f2f1}"},
                        {section: 11, name: I18n.i18n("settings.data", "Сбор данных"), icon: Fa.database}
                    ]: ActionSurface {
                        visible: SettingsUi.section-visible[item.section];
                        label: item.name; border-width: 0px; border-radius: 0px; horizontal-stretch: 0; height: 42px;
                        HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 8px; padding-bottom: 10px; spacing: 5px;
                            Glyph { text: item.icon; color: SettingsUi.section == item.section ? white : SettingsTheme.muted; }
                            SettingsLabel { text: item.name; font-family: SandboxTheme.font-family; font-weight: SettingsUi.section == item.section ? 700 : 600; }
                        }
                        Rectangle { y: parent.height - 2px; width: 100%; height: 2px; background: SettingsUi.section == item.section ? SettingsTheme.accent-alt : transparent; }
                        activated => { SettingsUi.section = item.section; if (item.section == 2 && root.connected) { MemoryUi.select(SettingsUi.selected-character); } }
                    }
                }
                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: SettingsTheme.divider; }
                }
                if SettingsUi.settings-error != "": Card {
                    background: SettingsTheme.error-background;
                    HorizontalLayout { padding: 12px; spacing: 10px;
                        Text { text: SettingsUi.settings-error; font-family: SandboxTheme.font-family; font-size: 12px; color: SettingsTheme.error-text; wrap: word-wrap; horizontal-stretch: 1; }
                        Centered { SettingsButton { text: I18n.i18n("common.dismiss", "Закрыть"); activated => { SettingsUi.settings-error = ""; } } }
                    }
                }
                if SettingsUi.section == 0: SettingsScrollView {
                    content-height: general-content.preferred-height;
                    general-content := VerticalLayout {
                        width: parent.width;
                        padding: 2px; padding-right: 10px;
                        spacing: SettingsTheme.section-gap; alignment: start;
                        SectionHeading {
                            title: I18n.i18n("settings.general.title", "Общие настройки");
                            description: I18n.i18n("settings.general.pyqt-description", "Базовые параметры интерфейса, приватности, памяти и языка.");
                            glyph: Fa.gear;
                        }
                        CollapsibleSettingsSection {
                            title: I18n.i18n("settings.general.visible-sections", "Видимые разделы");
                            subtitle: I18n.i18n("settings.general.visible-sections-note", "Включите только те разделы, которыми пользуетесь — остальные спрячутся из настроек и боковой панели.");
                            glyph: "\u{f0b0}";
                            expanded <=> root.general-sections-expanded;
                            for tab in [
                                {id: 1, label: "API"},
                                {id: 2, label: I18n.i18n("settings.characters", "Персонажи")},
                                {id: 3, label: I18n.i18n("settings.voice", "Озвучка")},
                                {id: 5, label: "ASR"},
                                {id: 6, label: I18n.i18n("settings.ai-engine", "ИИ-движок")},
                                {id: 7, label: I18n.i18n("settings.game", "Игра")},
                                {id: 8, label: I18n.i18n("settings.models", "Модели")},
                                {id: 9, label: I18n.i18n("settings.images", "Изображения")},
                                {id: 10, label: I18n.i18n("settings.updates", "Обновления")},
                                {id: 11, label: I18n.i18n("settings.data", "Сбор данных")},
                            ]: SettingsToggleRow {
                                title: tab.label;
                                checked: SettingsUi.section-visible[tab.id];
                                changed(value) => { SettingsUi.section-visibility(tab.id, value); }
                            }
                        }
                        CollapsibleSettingsSection {
                            title: I18n.i18n("settings.general.sandbox-panels", "Панели песочницы");
                            subtitle: I18n.i18n("settings.general.sandbox-panels-note", "Показывайте только нужные панели в правой части Песочницы.");
                            glyph: "\u{f0c3}";
                            SettingsText { text: I18n.i18n("settings.general.panel-controls-pending", "Управление видимостью панелей пока не предоставлено Rust-ядром."); color: SettingsTheme.muted; wrap: word-wrap; }
                        }
                        CollapsibleSettingsSection {
                            title: I18n.i18n("settings.general.privacy", "Приватность"); glyph: "\u{f21b}";
                            SettingsToggleRow {
                                title: I18n.i18n("settings.general.hide-private", "Скрывать приватные данные");
                                description: I18n.i18n("settings.general.hide-private-note", "Сохраняет предпочтение маскирования; подключение к отображению секретов ещё требуется.");
                                checked: SettingsUi.hide-private;
                                changed(value) => { SettingsUi.set-hide-private(value); }
                            }
                        }
                        CollapsibleSettingsSection {
                            title: I18n.i18n("settings.general.ipc", "Локальное IPC-управление");
                            subtitle: I18n.i18n("settings.general.ipc-note", "Локальный IPC принимает только явно разрешённые команды на 127.0.0.1.");
                            glyph: "\u{f0ac}";
                            SettingsText { text: I18n.i18n("settings.general.ipc-pending", "Настройка локального IPC пока недоступна в Rust API."); color: SettingsTheme.muted; wrap: word-wrap; }
                        }
                        CollapsibleSettingsSection {
                            title: I18n.i18n("settings.general.chat", "Настройки чата"); glyph: "\u{f086}";
                            SettingsToggleRow {
                                title: I18n.i18n("settings.voice.launcher", "Озвучивать в лаунчере");
                                checked: SettingsUi.settings-voice-launcher;
                                changed(value) => { SettingsUi.voice-launcher(value); }
                            }
                            SettingsToggleRow {
                                title: I18n.i18n("settings.voice.game", "Озвучивать в игре");
                                checked: SettingsUi.settings-voice-game;
                                changed(value) => { SettingsUi.voice-game(value); }
                            }
                        }
                        CollapsibleSettingsSection {
                            title: I18n.i18n("settings.general.state", "Состояние приложения"); glyph: Fa.gear;
                            SettingsText { text: I18n.i18n("settings.general.description", "Состояние приложения и сохранение параметров."); color: SettingsTheme.muted; }
                            SettingsRow {
                                title: I18n.i18n("settings.core.status", "Состояние ядра");
                                SettingsText { text: root.connected ? I18n.i18n("settings.core.ready", "Ядро работает") : root.connecting ? I18n.i18n("settings.core.starting", "Ядро запускается") : I18n.i18n("settings.core.unavailable", "Ядро недоступно"); }
                            }
                            SettingsRow { title: I18n.i18n("settings.revision", "Версия настроек"); SettingsText { text: SettingsUi.settings-revision; } }
                            SettingsRow { title: I18n.i18n("settings.preset.active", "Активный пресет"); SettingsText { text: "#" + SettingsUi.settings-active; } }
                            SettingsRow { title: I18n.i18n("settings.saved-state", "Сохранение"); SettingsText { text: SettingsUi.settings-persistence == 1 ? I18n.i18n("settings.saved", "Настройки сохранены") : SettingsUi.settings-persistence == 2 ? I18n.i18n("settings.save-failed", "Ошибка сохранения") : I18n.i18n("settings.saving", "Сохранение…"); } }
                        }
                    }
                }
                if SettingsUi.section == 1: VerticalLayout { padding: 2px; spacing: 16px;
                    SectionHeading { title: I18n.i18n("settings.api.title", "API и модели"); description: I18n.i18n("settings.api.description", "Каталог пресетов генерации и параметры провайдера."); glyph: "\u{f1e6}"; }
                    HorizontalLayout { spacing: 12px;
                        Card { width: max(230px, parent.width / 3); VerticalLayout { padding: 14px; spacing: 12px;
                            SettingsLabel { text: I18n.i18n("settings.presets", "Пресеты"); font-size: 15px; font-weight: 700; }
                            QuickAction { text: I18n.i18n("settings.preset.new", "Создать пресет"); enabled: root.connected;
                                activated => { SettingsUi.preset-edit-id = ""; SettingsUi.preset-save-token = ""; SettingsUi.preset-name = ""; SettingsUi.preset-model = ""; SettingsUi.preset-endpoint = "https://generativelanguage.googleapis.com/v1beta/"; SettingsUi.preset-key-env = "GEMINI_API_KEY"; SettingsUi.preset-temperature = "0.7"; SettingsUi.preset-tokens = "3000"; SettingsUi.preset-timeout = "60000"; }
                            }
                            ScrollView { content-width: self.visible-width; vertical-stretch: 1;
                                VerticalLayout { padding: 0px; spacing: 8px; alignment: start;
                                    for preset in SettingsUi.settings-presets: ActionSurface { height: 64px; selected: SettingsUi.preset-edit-id == preset.id; label: preset.name;
                                        VerticalLayout { padding: 10px; spacing: 3px;
                                            SettingsLabel { text: "#" + preset.id + " · " + preset.name; font-weight: 700; }
                                            SettingsLabel { text: preset.model; color: SettingsTheme.muted; font-size: 11px; }
                                        }
                                        activated => { SettingsUi.preset-edit(preset.id); }
                                    }
                                }
                            }
                        } }
                        ScrollView { content-width: self.visible-width; horizontal-stretch: 1;
                            VerticalLayout { padding: 2px; padding-right: 10px; spacing: 12px; alignment: start;
                                SettingsLabel { text: SettingsUi.preset-edit-id == "" ? I18n.i18n("settings.preset.new", "Создать пресет") : I18n.i18n("settings.preset.edit", "Редактирование пресета") + " #" + SettingsUi.preset-edit-id; font-size: 15px; font-weight: 700; }
                                EditorField { title: I18n.i18n("settings.preset.name", "Название"); text <=> SettingsUi.preset-name; }
                                EditorField { title: I18n.i18n("settings.preset.model", "Модель Gemini"); text <=> SettingsUi.preset-model; }
                                EditorField { title: I18n.i18n("settings.preset.endpoint", "Адрес API"); text <=> SettingsUi.preset-endpoint; }
                                EditorField { title: I18n.i18n("settings.preset.key-env", "Переменная окружения с ключом"); text <=> SettingsUi.preset-key-env; }
                                EditorField { title: I18n.i18n("settings.preset.temperature", "Температура"); text <=> SettingsUi.preset-temperature; }
                                HorizontalLayout { spacing: 10px;
                                    EditorField { title: I18n.i18n("settings.preset.tokens", "Максимум токенов"); text <=> SettingsUi.preset-tokens; }
                                    EditorField { title: I18n.i18n("settings.preset.timeout", "Тайм-аут, миллисекунды"); text <=> SettingsUi.preset-timeout; }
                                }
                                HorizontalLayout { spacing: 8px;
                                    SettingsButton { text: I18n.i18n("settings.save", "Сохранить"); enabled: root.connected; background: SettingsTheme.accent; activated => { SettingsUi.preset-save(); } }
                                    SettingsButton { text: I18n.i18n("settings.preset.use", "Сделать активным"); enabled: root.connected && SettingsUi.preset-edit-id != ""; activated => { SettingsUi.preset-activate(SettingsUi.preset-edit-id); } }
                                    SettingsButton { text: I18n.i18n("settings.delete", "Удалить"); enabled: root.connected && SettingsUi.preset-edit-id != ""; activated => { root.delete-id = SettingsUi.preset-edit-id; } }
                                }
                                if root.delete-id != "": Card { VerticalLayout { padding: 12px; spacing: 10px;
                                    Text { text: I18n.i18n("settings.delete.confirm", "Удалить пресет? Привязки останутся прежними и потребуют существующий пресет."); font-family: SandboxTheme.font-family; font-size: 12px; color: SettingsTheme.text; wrap: word-wrap; }
                                    HorizontalLayout { spacing: 8px;
                                        SettingsButton { text: I18n.i18n("settings.delete", "Удалить"); activated => { SettingsUi.preset-delete(root.delete-id); root.delete-id = ""; } }
                                        SettingsButton { text: I18n.i18n("sandbox.cancel", "Отменить"); activated => { root.delete-id = ""; } }
                                    }
                                } }
                            }
                        }
                    }
                }
                if SettingsUi.section == 2: VerticalLayout {
                    padding-left: 2px; padding-right: 6px; padding-bottom: 2px; spacing: 12px;
                    SectionHeading {
                        title: I18n.i18n("settings.characters.title", "Настройки персонажей");
                        description: I18n.i18n("settings.characters.description", "Профили, шаблоны поведения и история выбранного персонажа.");
                        glyph: "\u{f007}";
                    }
                    CharacterWorkspace { character <=> SettingsUi.selected-character; prompt-expanded <=> SettingsUi.character-prompt-expanded; connected: root.connected; }
                }
                if SettingsUi.section == 3: ScrollView { content-width: self.visible-width;
                    VerticalLayout { padding: 2px; padding-right: 10px; spacing: 16px; alignment: start;
                        SectionHeading { title: I18n.i18n("settings.voice", "Озвучка"); description: I18n.i18n("settings.voice.description", "Параметры голоса и места озвучивания."); glyph: "\u{f028}"; }
                        Card { VerticalLayout { padding: 18px; spacing: 18px;
                            SettingsToggleRow { title: I18n.i18n("settings.voice.launcher", "Озвучивать в лаунчере"); checked: SettingsUi.settings-voice-launcher; active: root.connected; changed(v) => { SettingsUi.voice-launcher(v); } }
                            SettingsToggleRow { title: I18n.i18n("settings.voice.game", "Озвучивать в игре"); checked: SettingsUi.settings-voice-game; active: root.connected; changed(v) => { SettingsUi.voice-game(v); } }
                            SettingsLabel { text: I18n.i18n("settings.voice.volume", "Громкость") + " · " + SettingsUi.settings-volume + "%"; }
                            VolumeSlider { value: SettingsUi.settings-volume; enabled: root.connected; changed(value) => { SettingsUi.volume(round(value)); } }
                            EditorField { title: I18n.i18n("settings.voice.id", "Идентификатор голоса"); text <=> root.voice-draft; }
                            SettingsButton { text: I18n.i18n("settings.save", "Сохранить"); enabled: root.connected; activated => { SettingsUi.voice-name(root.voice-draft); } }
                        } }
                    }
                }
                if SettingsUi.section == 4: LanguageSettingsPage {
                    language-selected(code) => { root.language-selected(code); }
                }
                if SettingsUi.section > 4: VerticalLayout { padding: 2px; spacing: 12px; alignment: start;
                    SettingsLabel { text: I18n.i18n("settings.section-unavailable", "Этот раздел пока недоступен."); color: SettingsTheme.muted; }
                }
            }
        }
    }
}
