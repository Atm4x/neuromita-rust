import { MemoryUi, MemoryPanel } from "../sandbox/memory.slint";
import { VolumeSlider } from "../components/volume-slider.slint";
import { ScrollView } from "std-widgets.slint";
import { SandboxTheme, Fa } from "../sandbox/theme.slint";
import { Caption, Glyph, HeaderButton, QuickAction, Centered, Field, Toggle } from "../sandbox/controls.slint";
import { ActionSurface } from "../components/controls.slint";
import { Avatar } from "../components/avatar.slint";
import { I18n } from "../i18n.slint";

export struct PresetItem { id: string, name: string, model: string, endpoint: string, key-env: string, temperature: string, tokens: string, timeout: string }
export global SettingsUi {
    in-out property <int> section;
    in-out property <[PresetItem]> settings-presets;
    in-out property <string> settings-error;
    in-out property <string> settings-revision;
    in-out property <int> settings-persistence;
    in-out property <string> settings-active;
    in-out property <int> settings-volume;
    in-out property <bool> settings-voice-launcher;
    in-out property <bool> settings-voice-game;
    in-out property <string> settings-voice-name;
    in-out property <string> mita-reply;
    in-out property <string> mita-react;
    in-out property <string> mita-initiate;
    in-out property <string> kind-reply;
    in-out property <string> kind-react;
    in-out property <string> kind-initiate;
    in-out property <bool> show-mita: true;
    in-out property <bool> show-kind: true;
    in-out property <int> selected-character;
    callback search-character(string);
    in-out property <string> preset-edit-id;
    in-out property <string> preset-save-token;
    in-out property <string> preset-name;
    in-out property <string> preset-model;
    in-out property <string> preset-endpoint: "https://generativelanguage.googleapis.com/v1beta/";
    in-out property <string> preset-key-env: "GEMINI_API_KEY";
    in-out property <string> preset-temperature: "0.7";
    in-out property <string> preset-tokens: "3000";
    in-out property <string> preset-timeout: "60000";
    callback preset-save();
    callback preset-edit(string);
    callback preset-delete(string);
    callback preset-activate(string);
    callback character-preset(int, int, string);
    callback voice-launcher(bool);
    callback voice-game(bool);
    callback voice-name(string);
    callback volume(int);
}

component Card inherits Rectangle {
    background: #0a0a18; border-radius: 14px; border-width: 1px; border-color: SandboxTheme.border;
    @children
}

component EditorField inherits VerticalLayout {
    in property <string> title;
    in-out property <string> text;
    height: 64px; spacing: 6px; padding: 0px;
    Caption { text: root.title; font-size: 12px; color: SandboxTheme.muted; }
    Field { text <=> root.text; height: 40px; }
}

component SectionHeading inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> glyph;
    height: 50px; padding: 0px; spacing: 14px;
    Rectangle { width: 48px; height: 48px; border-radius: 12px; background: #b74b7d1f;
        Glyph { text: root.glyph; color: SandboxTheme.accent-alt; width: 100%; height: 100%; font-size: 25px; }
    }
    VerticalLayout { padding: 0px; spacing: 3px; alignment: center;
        Caption { text: root.title; font-family: "Segoe UI"; font-size: 23px; font-weight: 700; }
        Caption { text: root.description; font-size: 12px; color: SandboxTheme.muted; }
    }
}

component PresetChoice inherits Rectangle {
    in property <string> value;
    callback selected(string);
    height: 40px; min-width: 0px; background: #080912; border-width: 1px; border-color: SandboxTheme.border; border-radius: 8px;
    HorizontalLayout { padding-left: 12px; padding-right: 10px; spacing: 8px;
        Caption { text: root.value == "active" ? I18n.i18n("settings.preset.active", "Активный пресет") + " (#" + SettingsUi.settings-active + ")" : "#" + root.value; horizontal-stretch: 1; }
        Glyph { text: Fa.down; font-size: 11px; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow { y: root.height + 3px; width: root.width; height: min(300px, (SettingsUi.settings-presets.length + 1) * 34px + 8px); close-policy: close-on-click-outside;
        Rectangle { width: 100%; height: 100%; background: #171423; border-radius: 9px; border-width: 1px; border-color: SandboxTheme.border;
            ScrollView { width: 100%; height: 100%; content-width: self.visible-width;
                VerticalLayout { padding: 4px; spacing: 2px; alignment: start;
                    QuickAction { text: I18n.i18n("settings.preset.active", "Активный пресет"); activated => { root.selected("active"); menu.close(); } }
                    for preset in SettingsUi.settings-presets: QuickAction { text: "#" + preset.id + " · " + preset.name; activated => { root.selected(preset.id); menu.close(); } }
                }
            }
        }
    }
}


component CharacterAccordion inherits VerticalLayout {
    in property <string> title;
    in property <string> glyph;
    in-out property <bool> expanded;
    spacing: 0px;
    Rectangle {
        height: 42px; background: #111020;
        border-radius: 9px; border-width: 1px; border-color: SandboxTheme.border;
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px; spacing: 8px;
            Glyph { text: root.glyph; color: SandboxTheme.accent-alt; font-size: 13px; }
            Caption { text: root.title; font-weight: 700; horizontal-stretch: 1; }
            Glyph { text: Fa.down; color: SandboxTheme.muted; font-size: 11px; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.expanded = !root.expanded; } }
    }
}

component CharacterWorkspace inherits HorizontalLayout {
    in property <bool> connected;
    in-out property <int> character;
    in-out property <string> search;
    in-out property <bool> prompt-expanded: true;
    in-out property <bool> provider-expanded;
    in-out property <bool> maintenance-expanded;
    in-out property <bool> danger-expanded;
    spacing: 9px;
    changed search => { SettingsUi.search-character(root.search); }
    Rectangle {
        width: max(240px, parent.width * 0.25 - 9px);
        background: #0e101ff7; border-width: 1px; border-color: SandboxTheme.border; border-radius: 9px;
        VerticalLayout {
            padding: 10px; spacing: 8px;
            HorizontalLayout {
                height: 30px;
                Caption { text: I18n.i18n("settings.characters.library", "Библиотека персонажей"); font-size: 14px; font-weight: 700; horizontal-stretch: 1; }
                Caption { text: "2"; color: SandboxTheme.muted; }
            }
            Field { text <=> root.search; placeholder: I18n.i18n("settings.characters.search", "Поиск персонажей…"); height: 38px; }
            ScrollView {
                content-width: self.visible-width; vertical-stretch: 1;
                VerticalLayout {
                    padding: 0px; spacing: 4px; alignment: start;
                    if SettingsUi.show-mita: ActionSurface {
                        height: 57px; label: I18n.i18n("sandbox.character.mita", "Мита");
                        selected: root.character == 0;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 7px; spacing: 10px;
                            Centered { width: 32px; Avatar { width: 32px; height: 32px; source: @image-url("../../assets/avatars/crazy.png"); surface: SandboxTheme.panel; } }
                            VerticalLayout {
                                padding: 0px; spacing: 2px; alignment: center;
                                Caption { text: I18n.i18n("sandbox.character.mita", "Мита"); font-weight: 700; }
                                Caption { text: "id: mita"; color: SandboxTheme.muted; font-size: 11px; }
                            }
                        }
                        activated => { root.character = 0; if (root.connected) { MemoryUi.select(0); } }
                    }
                    if SettingsUi.show-kind: ActionSurface {
                        height: 57px; label: I18n.i18n("sandbox.character.kind", "Добрая Мита");
                        selected: root.character == 1;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 7px; spacing: 10px;
                            Centered { width: 32px; Avatar { width: 32px; height: 32px; source: @image-url("../../assets/avatars/kind.png"); surface: SandboxTheme.panel; } }
                            VerticalLayout {
                                padding: 0px; spacing: 2px; alignment: center;
                                Caption { text: I18n.i18n("sandbox.character.kind", "Добрая Мита"); font-weight: 700; }
                                Caption { text: "id: kind-mita"; color: SandboxTheme.muted; font-size: 11px; }
                            }
                        }
                        activated => { root.character = 1; if (root.connected) { MemoryUi.select(1); } }
                    }
                }
            }
        }
    }
    Rectangle {
        min-width: 350px; horizontal-stretch: 1;
        background: #0e101ff7; border-width: 1px; border-color: SandboxTheme.border; border-radius: 9px;
        VerticalLayout {
            padding: 12px; spacing: 14px;
            HorizontalLayout {
                height: 56px; spacing: 14px;
                Centered { width: 56px; Avatar {
                    width: 56px; height: 56px;
                    source: root.character == 0 ? @image-url("../../assets/avatars/crazy.png") : @image-url("../../assets/avatars/kind.png");
                    surface: SandboxTheme.panel;
                } }
                VerticalLayout {
                    padding: 0px; spacing: 3px; alignment: center;
                    Caption {
                        text: root.character == 0 ? I18n.i18n("sandbox.character.mita", "Мита") : I18n.i18n("sandbox.character.kind", "Добрая Мита");
                        font-size: 19px; font-weight: 700;
                    }
                    Caption { text: root.character == 0 ? "id: mita" : "id: kind-mita"; color: SandboxTheme.muted; }
                }
            }
            ScrollView {
                content-width: self.visible-width; vertical-stretch: 1;
                VerticalLayout {
                    padding: 0px; padding-right: 8px; spacing: 12px; alignment: start;
                    CharacterAccordion { title: I18n.i18n("settings.characters.prompt-set", "Набор промптов"); glyph: "\u{f15c}"; expanded <=> root.prompt-expanded; }
                    if root.prompt-expanded: Rectangle {
                        background: #0a0a18; border-radius: 9px; border-width: 1px; border-color: SandboxTheme.border;
                        VerticalLayout {
                            padding: 14px; spacing: 12px;
                            Caption { text: I18n.i18n("settings.characters.prompt-set", "Набор промптов"); font-weight: 600; }
                            Field {
                                placeholder: I18n.i18n("settings.characters.prompt-unavailable", "Каталог наборов промптов не подключён");
                                enabled: false; height: 38px;
                            }
                            Caption {
                                text: I18n.i18n("settings.characters.prompt-contract", "Выбор набора будет доступен после интеграции контракта Python PromptPack.");
                                color: SandboxTheme.muted; font-size: 11px; wrap: word-wrap;
                            }
                            Rectangle { height: 1px; background: #ffffff1f; }
                            Caption { text: I18n.i18n("settings.characters.generation-presets", "Пресеты генерации"); font-size: 14px; font-weight: 700; }
                            for title[index] in [I18n.i18n("settings.operation.reply", "Ответ на сообщение"), I18n.i18n("settings.operation.react", "Реакция на событие"), I18n.i18n("settings.operation.initiate", "Инициатива")]: VerticalLayout {
                                padding: 0px; spacing: 5px;
                                Caption { text: title; color: SandboxTheme.muted; }
                                PresetChoice {
                                    value: root.character == 0 ? index == 0 ? SettingsUi.mita-reply : index == 1 ? SettingsUi.mita-react : SettingsUi.mita-initiate : index == 0 ? SettingsUi.kind-reply : index == 1 ? SettingsUi.kind-react : SettingsUi.kind-initiate;
                                    selected(value) => { if (root.connected) { SettingsUi.character-preset(root.character, index, value); } }
                                }
                            }
                        }
                    }
                    CharacterAccordion { title: I18n.i18n("settings.characters.provider", "Провайдер для персонажа"); glyph: "\u{f1e6}"; expanded <=> root.provider-expanded; }
                    if root.provider-expanded: Rectangle {
                        background: #0a0a18; border-radius: 9px; border-width: 1px; border-color: SandboxTheme.border;
                        VerticalLayout {
                            padding: 14px; spacing: 8px;
                            Caption { text: I18n.i18n("settings.characters.provider-note", "Провайдер задаётся выбранным пресетом генерации."); color: SandboxTheme.muted; wrap: word-wrap; }
                        }
                    }
                    CharacterAccordion { title: I18n.i18n("settings.characters.history", "История персонажа и память"); glyph: "\u{f1da}"; expanded <=> MemoryUi.open; }
                    if MemoryUi.open: VerticalLayout {
                        spacing: 8px;
                        Caption { text: I18n.i18n("settings.characters.history-actions", "Операции с историей будут подключены к существующему API управления данными."); color: SandboxTheme.muted; wrap: word-wrap; }
                        MemoryPanel { width: 100%; }
                    }
                    CharacterAccordion { title: I18n.i18n("settings.characters.maintenance", "Обслуживание"); glyph: Fa.gear; expanded <=> root.maintenance-expanded; }
                    if root.maintenance-expanded: Rectangle {
                        background: #0a0a18; border-radius: 9px; border-width: 1px; border-color: SandboxTheme.border;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Caption { text: I18n.i18n("settings.characters.maintenance-note", "Импорт, переиндексация и удаление дублей требуют контракта обслуживания истории."); color: SandboxTheme.muted; wrap: word-wrap; }
                        }
                    }
                    CharacterAccordion { title: I18n.i18n("settings.characters.danger", "Опасная зона — все персонажи"); glyph: "\u{f071}"; expanded <=> root.danger-expanded; }
                    if root.danger-expanded: Rectangle {
                        background: #0a0a18; border-radius: 9px; border-width: 1px; border-color: SandboxTheme.border;
                        VerticalLayout {
                            padding: 12px;
                            Caption { text: I18n.i18n("settings.characters.danger-note", "Глобальные разрушительные операции здесь не выполняются без отдельного API и подтверждения."); color: #ff8bb3; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> connected;
    in property <bool> connecting;
    callback home();
    property <string> delete-id;
    property <string> voice-draft: SettingsUi.settings-voice-name;
    background: SandboxTheme.canvas;
    VerticalLayout {
        padding-left: 28px; padding-right: 28px; padding-top: 24px; padding-bottom: 24px; spacing: 18px;
        HorizontalLayout { height: 57px; spacing: 12px;
            Glyph { text: Fa.gear; color: #ff6db7; width: 23px; font-size: 22px; }
            VerticalLayout { padding: 0px; alignment: center; spacing: 4px; horizontal-stretch: 1;
                Caption { text: I18n.i18n("page.settings.title", "Настройки"); font-size: 26px; font-weight: 700; }
                Caption { text: I18n.i18n("settings.subtitle", "Параметры NeuroMita: персонажи, модели и озвучка."); color: SandboxTheme.muted; font-size: 12px; }
            }
            Centered { HeaderButton { text: I18n.i18n("sandbox.header.home", "На главную"); activated => { root.home(); } } }
        }
        Rectangle { background: SandboxTheme.panel; border-radius: 16px; border-width: 1px; border-color: SandboxTheme.border;
            VerticalLayout { padding: 14px; spacing: 14px;
                HorizontalLayout { padding-left: 18px; padding-right: 18px; height: 42px; spacing: 12px;
                    for item[index] in [
                        {name: I18n.i18n("settings.general", "Общие"), icon: Fa.gear},
                        {name: "API", icon: "\u{f1e6}"},
                        {name: I18n.i18n("settings.characters", "Персонажи"), icon: Fa.badge},
                        {name: I18n.i18n("settings.voice", "Озвучка"), icon: "\u{f028}"}
                    ]: ActionSurface {
                        label: item.name; border-width: 0px; border-radius: 0px; horizontal-stretch: 0;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 6px;
                            Glyph { text: item.icon; color: SettingsUi.section == index ? SandboxTheme.icon : SandboxTheme.muted; }
                            Caption { text: item.name; font-weight: SettingsUi.section == index ? 700 : 400; }
                        }
                        Rectangle { y: parent.height - 2px; width: 100%; height: 2px; background: SettingsUi.section == index ? SandboxTheme.accent : transparent; }
                        activated => { SettingsUi.section = index; if (index == 2 && root.connected) { MemoryUi.select(SettingsUi.selected-character); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: #ffffff12; }
                if SettingsUi.settings-error != "": Card {
                    background: #32172a;
                    HorizontalLayout { padding: 12px; spacing: 10px;
                        Text { text: SettingsUi.settings-error; font-family: SandboxTheme.font-family; font-size: 12px; color: #ffafc5; wrap: word-wrap; horizontal-stretch: 1; }
                        Centered { HeaderButton { text: I18n.i18n("common.dismiss", "Закрыть"); activated => { SettingsUi.settings-error = ""; } } }
                    }
                }
                if SettingsUi.section == 0: ScrollView { content-width: self.visible-width;
                    VerticalLayout { padding: 2px; padding-right: 10px; spacing: 16px; alignment: start;
                        SectionHeading { title: I18n.i18n("settings.general.title", "Общие настройки"); description: I18n.i18n("settings.general.description", "Состояние приложения и сохранение параметров."); glyph: Fa.gear; }
                        Card { VerticalLayout { padding: 18px; spacing: 14px;
                            Caption { text: root.connected ? I18n.i18n("settings.core.ready", "Ядро работает") : root.connecting ? I18n.i18n("settings.core.starting", "Ядро запускается") : I18n.i18n("settings.core.unavailable", "Ядро недоступно"); font-size: 15px; font-weight: 700; }
                            Caption { text: I18n.i18n("settings.revision", "Версия настроек") + ": " + SettingsUi.settings-revision; }
                            Caption { text: SettingsUi.settings-persistence == 1 ? I18n.i18n("settings.saved", "Настройки сохранены") : SettingsUi.settings-persistence == 2 ? I18n.i18n("settings.save-failed", "Ошибка сохранения") : I18n.i18n("settings.saving", "Сохранение…"); color: SandboxTheme.muted; }
                            Caption { text: I18n.i18n("settings.preset.active", "Активный пресет") + ": #" + SettingsUi.settings-active; }
                        } }
                    }
                }
                if SettingsUi.section == 1: VerticalLayout { padding: 2px; spacing: 16px;
                    SectionHeading { title: I18n.i18n("settings.api.title", "API и модели"); description: I18n.i18n("settings.api.description", "Каталог пресетов генерации и параметры провайдера."); glyph: "\u{f1e6}"; }
                    HorizontalLayout { spacing: 12px;
                        Card { width: max(230px, parent.width / 3); VerticalLayout { padding: 14px; spacing: 12px;
                            Caption { text: I18n.i18n("settings.presets", "Пресеты"); font-size: 15px; font-weight: 700; }
                            QuickAction { text: I18n.i18n("settings.preset.new", "Создать пресет"); enabled: root.connected;
                                activated => { SettingsUi.preset-edit-id = ""; SettingsUi.preset-save-token = ""; SettingsUi.preset-name = ""; SettingsUi.preset-model = ""; SettingsUi.preset-endpoint = "https://generativelanguage.googleapis.com/v1beta/"; SettingsUi.preset-key-env = "GEMINI_API_KEY"; SettingsUi.preset-temperature = "0.7"; SettingsUi.preset-tokens = "3000"; SettingsUi.preset-timeout = "60000"; }
                            }
                            ScrollView { content-width: self.visible-width; vertical-stretch: 1;
                                VerticalLayout { padding: 0px; spacing: 8px; alignment: start;
                                    for preset in SettingsUi.settings-presets: ActionSurface { height: 64px; selected: SettingsUi.preset-edit-id == preset.id; label: preset.name;
                                        VerticalLayout { padding: 10px; spacing: 3px;
                                            Caption { text: "#" + preset.id + " · " + preset.name; font-weight: 700; }
                                            Caption { text: preset.model; color: SandboxTheme.muted; font-size: 11px; }
                                        }
                                        activated => { SettingsUi.preset-edit(preset.id); }
                                    }
                                }
                            }
                        } }
                        ScrollView { content-width: self.visible-width; horizontal-stretch: 1;
                            VerticalLayout { padding: 2px; padding-right: 10px; spacing: 12px; alignment: start;
                                Caption { text: SettingsUi.preset-edit-id == "" ? I18n.i18n("settings.preset.new", "Создать пресет") : I18n.i18n("settings.preset.edit", "Редактирование пресета") + " #" + SettingsUi.preset-edit-id; font-size: 15px; font-weight: 700; }
                                EditorField { title: I18n.i18n("settings.preset.name", "Название"); text <=> SettingsUi.preset-name; }
                                EditorField { title: I18n.i18n("settings.preset.model", "Модель Gemini"); text <=> SettingsUi.preset-model; }
                                EditorField { title: I18n.i18n("settings.preset.endpoint", "Адрес API"); text <=> SettingsUi.preset-endpoint; }
                                EditorField { title: I18n.i18n("settings.preset.key-env", "Переменная окружения с ключом"); text <=> SettingsUi.preset-key-env; }
                                EditorField { title: I18n.i18n("settings.preset.temperature", "Температура"); text <=> SettingsUi.preset-temperature; }
                                HorizontalLayout { spacing: 10px;
                                    EditorField { title: I18n.i18n("settings.preset.tokens", "Максимум токенов"); text <=> SettingsUi.preset-tokens; }
                                    EditorField { title: I18n.i18n("settings.preset.timeout", "Тайм-аут, миллисекунды"); text <=> SettingsUi.preset-timeout; }
                                }
                                HorizontalLayout { spacing: 8px;
                                    HeaderButton { text: I18n.i18n("settings.save", "Сохранить"); enabled: root.connected; background: SandboxTheme.accent; activated => { SettingsUi.preset-save(); } }
                                    HeaderButton { text: I18n.i18n("settings.preset.use", "Сделать активным"); enabled: root.connected && SettingsUi.preset-edit-id != ""; activated => { SettingsUi.preset-activate(SettingsUi.preset-edit-id); } }
                                    HeaderButton { text: I18n.i18n("settings.delete", "Удалить"); enabled: root.connected && SettingsUi.preset-edit-id != ""; activated => { root.delete-id = SettingsUi.preset-edit-id; } }
                                }
                                if root.delete-id != "": Card { VerticalLayout { padding: 12px; spacing: 10px;
                                    Text { text: I18n.i18n("settings.delete.confirm", "Удалить пресет? Привязки останутся прежними и потребуют существующий пресет."); font-family: SandboxTheme.font-family; font-size: 12px; color: SandboxTheme.text; wrap: word-wrap; }
                                    HorizontalLayout { spacing: 8px;
                                        HeaderButton { text: I18n.i18n("settings.delete", "Удалить"); activated => { SettingsUi.preset-delete(root.delete-id); root.delete-id = ""; } }
                                        HeaderButton { text: I18n.i18n("sandbox.cancel", "Отменить"); activated => { root.delete-id = ""; } }
                                    }
                                } }
                            }
                        }
                    }
                }
                if SettingsUi.section == 2: VerticalLayout {
                    padding: 2px; spacing: 12px;
                    SectionHeading {
                        title: I18n.i18n("settings.characters", "Персонажи");
                        description: I18n.i18n("settings.characters.description", "Библиотека персонажей, наборы промптов, пресеты генерации и память.");
                        glyph: Fa.badge;
                    }
                    CharacterWorkspace { character <=> SettingsUi.selected-character; connected: root.connected; }
                }
                if SettingsUi.section == 3: ScrollView { content-width: self.visible-width;
                    VerticalLayout { padding: 2px; padding-right: 10px; spacing: 16px; alignment: start;
                        SectionHeading { title: I18n.i18n("settings.voice", "Озвучка"); description: I18n.i18n("settings.voice.description", "Параметры голоса и места озвучивания."); glyph: "\u{f028}"; }
                        Card { VerticalLayout { padding: 18px; spacing: 18px;
                            HorizontalLayout { height: 32px; Caption { text: I18n.i18n("settings.voice.launcher", "Озвучивать в лаунчере"); horizontal-stretch: 1; } Centered { width: 42px; Toggle { checked: SettingsUi.settings-voice-launcher; enabled: root.connected; activated => { SettingsUi.voice-launcher(!SettingsUi.settings-voice-launcher); } } } }
                            HorizontalLayout { height: 32px; Caption { text: I18n.i18n("settings.voice.game", "Озвучивать в игре"); horizontal-stretch: 1; } Centered { width: 42px; Toggle { checked: SettingsUi.settings-voice-game; enabled: root.connected; activated => { SettingsUi.voice-game(!SettingsUi.settings-voice-game); } } } }
                            Caption { text: I18n.i18n("settings.voice.volume", "Громкость") + " · " + SettingsUi.settings-volume + "%"; }
                            VolumeSlider { value: SettingsUi.settings-volume; enabled: root.connected; changed(value) => { SettingsUi.volume(round(value)); } }
                            EditorField { title: I18n.i18n("settings.voice.id", "Идентификатор голоса"); text <=> root.voice-draft; }
                            HeaderButton { text: I18n.i18n("settings.save", "Сохранить"); enabled: root.connected; activated => { SettingsUi.voice-name(root.voice-draft); } }
                        } }
                    }
                }
            }
        }
    }
}
