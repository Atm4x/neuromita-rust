import { Theme } from "../theme.slint";
import { Label, ActionSurface } from "../components/controls.slint";
import { I18n } from "../i18n.slint";
import { ComboBox, ScrollView, TextEdit } from "std-widgets.slint";

export struct MemoryItem {
    id: string,
    content: string,
    state: string,
    kind: string,
    priority: string,
    protected: bool,
}

export enum MemoryAction { add, update, forget, restore, soft-delete, protect, unprotect, set-island, refresh }

component MemoryButton inherits ActionSurface {
    in property <string> caption;
    height: 38px;
    border-width: 1px;
    border-color: Theme.border;
    background: !root.enabled ? #ffffff08 : root.hovered ? Theme.accent : Theme.panel;
    Label {
        text: root.caption;
        horizontal-alignment: center;
        font-weight: 600;
    }
}

export component MemoryPage inherits Rectangle {
    in property <[MemoryItem]> memories;
    in-out property <string> character: "mita";
    in-out property <string> selected-id;
    in-out property <string> selected-state;
    in-out property <bool> selected-protected;
    in-out property <string> draft;
    in-out property <int> island-index: 0;
    in property <bool> busy;
    in property <bool> ready;
    in property <string> status;
    callback change-character(string);
    callback execute(MemoryAction, string, string);
    background: Theme.background;
    HorizontalLayout {
        padding: 28px;
        spacing: 22px;
        VerticalLayout {
            min-width: 260px;
            horizontal-stretch: 3;
            spacing: 12px;
            Label { height: 34px; text: I18n.i18n("memory.title", "Память персонажа"); font-size: 25px; font-weight: 700; }
            Label { height: 28px; text: I18n.i18n("memory.description", "Канонические воспоминания из Timeline"); color: Theme.muted; }
            HorizontalLayout {
                height: 42px; spacing: 8px;
                for person in [ { id: "mita", label: "Мита" }, { id: "kind-mita", label: "Добрая Мита" } ]: MemoryButton {
                    horizontal-stretch: 1;
                    caption: person.label;
                    selected: root.character == person.id;
                    activated => {
                        root.character = person.id;
                        root.selected-id = "";
                        root.draft = "";
                        root.change-character(person.id);
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.divider; }
            ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 0px;
                    spacing: 8px;
                    for item in root.memories: ActionSurface {
                        height: 90px;
                        selected: root.selected-id == item.id;
                        border-width: 1px;
                        border-color: self.selected ? Theme.accent : Theme.border;
                        background: self.selected ? Theme.selected : Theme.panel;
                        activated => {
                            root.selected-id = item.id;
                            root.selected-state = item.state;
                            root.selected-protected = item.protected;
                            root.draft = item.content;
                        }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Label {
                                height: 43px;
                                text: item.content;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                            Label {
                                height: 16px;
                                text: item.kind + " · " + item.state + " · " + item.priority + (item.protected ? " · protected" : "");
                                font-size: 11px;
                                color: Theme.muted;
                            }
                        }
                    }
                }
            }
            if root.ready && root.memories.length == 0: Label {
                height: 48px;
                text: I18n.i18n("memory.empty", "У персонажа пока нет воспоминаний.");
                color: Theme.muted;
            }
        }
        Rectangle { width: 1px; background: Theme.divider; }
        VerticalLayout {
            horizontal-stretch: 2;
            min-width: 260px;
            spacing: 13px;
            Label { height: 32px; text: I18n.i18n("memory.editor", "Редактор памяти"); font-size: 21px; font-weight: 700; }
            Label {
                height: 48px;
                text: root.status;
                wrap: word-wrap;
                color: Theme.muted;
            }
            Label { height: 22px; text: root.selected-id == "" ? I18n.i18n("memory.new", "Новое воспоминание") : I18n.i18n("memory.existing", "Выбранное воспоминание"); font-weight: 600; }
            TextEdit {
                height: 152px;
                text <=> root.draft;
                enabled: root.ready && !root.busy;
            }
            HorizontalLayout {
                height: 38px; spacing: 8px;
                MemoryButton {
                    horizontal-stretch: 1;
                    caption: I18n.i18n("memory.create", "Добавить");
                    enabled: root.ready && !root.busy && root.selected-id == "";
                    activated => { root.execute(MemoryAction.add, "", root.draft); }
                }
                MemoryButton {
                    horizontal-stretch: 1;
                    caption: I18n.i18n("memory.save", "Сохранить");
                    enabled: root.ready && !root.busy && root.selected-id != "" && root.selected-state == "active";
                    activated => { root.execute(MemoryAction.update, root.selected-id, root.draft); }
                }
            }
            MemoryButton {
                caption: I18n.i18n("memory.clear-selection", "Снять выбор / новое воспоминание");
                activated => { root.selected-id = ""; root.draft = ""; root.selected-state = ""; root.selected-protected = false; }
            }
            Rectangle { height: 1px; background: Theme.divider; }
            Label { height: 18px; text: I18n.i18n("memory.island", "Типизированная область памяти"); color: Theme.muted; }
            ComboBox {
                model: ["Отношения", "Мнения", "Предпочтения", "Обязательства/конфликты", "Язык"];
                current-index <=> root.island-index;
                enabled: root.ready && !root.busy;
                height: 38px;
            }
            MemoryButton {
                caption: I18n.i18n("memory.save-island", "Создать или обновить область");
                enabled: root.ready && !root.busy && root.selected-id == "";
                activated => {
                    root.execute(MemoryAction.set-island,
                        root.island-index == 0 ? "relationship"
                        : root.island-index == 1 ? "opinion"
                        : root.island-index == 2 ? "preferences"
                        : root.island-index == 3 ? "commitments_conflicts" : "language", root.draft);
                }
            }
            Rectangle { height: 1px; background: Theme.divider; }
            HorizontalLayout {
                height: 38px; spacing: 8px;
                MemoryButton {
                    horizontal-stretch: 1;
                    caption: I18n.i18n("memory.forget", "Забыть");
                    enabled: root.ready && !root.busy && root.selected-id != "" && root.selected-state == "active" && !root.selected-protected;
                    activated => { root.execute(MemoryAction.forget, root.selected-id, ""); }
                }
                MemoryButton {
                    horizontal-stretch: 1;
                    caption: I18n.i18n("memory.restore", "Восстановить");
                    enabled: root.ready && !root.busy && root.selected-id != "" && root.selected-state != "active";
                    activated => { root.execute(MemoryAction.restore, root.selected-id, ""); }
                }
            }
            HorizontalLayout {
                height: 38px; spacing: 8px;
                MemoryButton {
                    horizontal-stretch: 1;
                    caption: root.selected-protected ? I18n.i18n("memory.unprotect", "Снять защиту") : I18n.i18n("memory.protect", "Защитить");
                    enabled: root.ready && !root.busy && root.selected-id != "" && root.selected-state != "deleted";
                    activated => { root.execute(root.selected-protected ? MemoryAction.unprotect : MemoryAction.protect, root.selected-id, ""); }
                }
                MemoryButton {
                    horizontal-stretch: 1;
                    caption: I18n.i18n("memory.delete", "Удалить мягко");
                    enabled: root.ready && !root.busy && root.selected-id != "" && root.selected-state != "deleted" && !root.selected-protected;
                    activated => { root.execute(MemoryAction.soft-delete, root.selected-id, ""); }
                }
            }
            MemoryButton {
                caption: I18n.i18n("memory.refresh", "Обновить из Core");
                enabled: !root.busy;
                activated => { root.execute(MemoryAction.refresh, "", ""); }
            }
            Rectangle { vertical-stretch: 1; }
            Label {
                height: 62px;
                wrap: word-wrap;
                color: Theme.muted;
                text: I18n.i18n("memory.scope", "Операции проходят через Character Presenter. Физический purge здесь недоступен.");
            }
        }
    }
}
