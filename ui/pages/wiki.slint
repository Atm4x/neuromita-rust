import { Theme, Icons } from "../theme.slint";
import { Label, Icon, ActionSurface } from "../components/controls.slint";
import { ScrollView } from "std-widgets.slint";

export struct WikiArticleEntry {
    id: string,
    title: string,
}

export struct WikiSection {
    id: string,
    title: string,
    level: int,
    text: styled-text,
}

export struct WikiHomeCardEntry {
    title: string,
    description: string,
    destination: string,
}

component WikiHomeTile inherits Rectangle {
    in property <WikiHomeCardEntry> card;
    callback chosen(string);
    callback wheel-scroll(length);
    height: 136px;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    VerticalLayout {
        padding: 17px;
        spacing: 9px;
        Text { text: root.card.title; color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
        Text { text: root.card.description; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.chosen(root.card.destination); }
        scroll-event(event) => {
            root.wheel-scroll(event.delta-y);
            return accept;
        }
    }
}

export component WikiReader inherits Rectangle {
    in property <[WikiArticleEntry]> articles;
    in property <[WikiHomeCardEntry]> home-left;
    in property <[WikiHomeCardEntry]> home-right;
    in property <string> current-article;
    in property <string> current-title;
    in property <styled-text> article-text;
    in property <[WikiSection]> sections;
    in property <int> scroll-target: 0;
    in property <int> scroll-revision: 0;
    in property <string> language: "ru";
    in property <bool> can-back;
    in property <bool> can-forward;
    callback open-article(string);
    callback open-link(string);
    callback back();
    callback forward();
    callback change-language(string);

    background: Theme.background;
    HorizontalLayout {
        padding: 24px;
        spacing: 18px;
        Rectangle {
            width: 240px;
            border-radius: 14px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                HorizontalLayout {
                    height: 42px;
                    spacing: 9px;
                    Icon { source: Icons.wiki; width: 20px; height: 20px; }
                    Label { text: root.language == "ru" ? "Вики NeuroMita" : "NeuroMita Wiki"; font-weight: 700; font-size: 16px; }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                for item in root.articles: ActionSurface {
                    height: 43px;
                    label: item.title;
                    selected: root.current-article == item.id;
                    background: self.selected ? Theme.selected : Theme.hover;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 10px;
                        Label { text: item.title; overflow: elide; min-width: 0px; }
                    }
                    activated => { root.open-article(item.id); }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Label {
                    text: root.language == "ru" ? "Документация доступна без сети" : "Documentation is available offline";
                    color: Theme.muted;
                    wrap: word-wrap;
                    font-size: 11px;
                    height: 45px;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1; min-width: 0px;
            background: Theme.panel;
            border-width: 1px; border-color: Theme.border; border-radius: 14px;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    height: 35px; spacing: 7px;
                    ActionSurface {
                        width: 35px; height: 35px; label: "Back";
                        enabled: root.can-back; background: Theme.hover;
                        Label { text: "‹"; horizontal-alignment: center; font-size: 25px; }
                        activated => { root.back(); }
                    }
                    ActionSurface {
                        width: 35px; height: 35px; label: "Forward";
                        enabled: root.can-forward; background: Theme.hover;
                        Label { text: "›"; horizontal-alignment: center; font-size: 25px; }
                        activated => { root.forward(); }
                    }
                    ActionSurface {
                        width: 65px; height: 35px; label: "Wiki home"; background: Theme.hover;
                        Label { text: root.language == "ru" ? "Домой" : "Home"; horizontal-alignment: center; }
                        activated => { root.open-article("index.md"); }
                    }
                    Label {
                        text: root.current-title;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        font-size: 19px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    ActionSurface {
                        width: 43px; height: 35px; label: "Русский";
                        selected: root.language == "ru";
                        background: self.selected ? Theme.selected : Theme.hover;
                        Label { text: "RU"; horizontal-alignment: center; }
                        activated => { root.change-language("ru"); }
                    }
                    ActionSurface {
                        width: 43px; height: 35px; label: "English";
                        selected: root.language == "en";
                        background: self.selected ? Theme.selected : Theme.hover;
                        Label { text: "EN"; horizontal-alignment: center; }
                        activated => { root.change-language("en"); }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                if root.current-article == "index.md": home-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, home-layout.preferred-height + 60px);
                    home-layout := VerticalLayout {
                        x: 12px; y: 12px;
                        width: max(1px, parent.width - 24px);
                        spacing: 18px;
                        Text {
                            text: root.language == "ru" ? "Что вы хотите настроить?" : "What would you like to configure?";
                            color: Theme.text; font-size: 23px; font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;
                                for card in root.home-left: WikiHomeTile {
                                    card: card;
                                    chosen(target) => { root.open-link(target); }
                                    wheel-scroll(delta) => {
                                        home-scroll.content-y = clamp(
                                            home-scroll.content-y + delta,
                                            min(0px, home-scroll.visible-height - home-scroll.content-height),
                                            0px
                                        );
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 12px;
                                for card in root.home-right: WikiHomeTile {
                                    card: card;
                                    chosen(target) => { root.open-link(target); }
                                    wheel-scroll(delta) => {
                                        home-scroll.content-y = clamp(
                                            home-scroll.content-y + delta,
                                            min(0px, home-scroll.visible-height - home-scroll.content-height),
                                            0px
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
                if root.current-article != "index.md": article-scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, article-layout.preferred-height + 28px);
                    private property <string> observed-article: root.current-article;
                    changed observed-article => { article-scroll.content-y = 0px; }
                    article-layout := VerticalLayout {
                        x: 10px; y: 10px;
                        width: max(1px, article-scroll.visible-width - 36px);
                        spacing: 15px;
                        for section[index] in root.sections: VerticalLayout {
                            spacing: 7px;
                            private property <int> observed-revision: root.scroll-revision;
                            changed observed-revision => {
                                if index == root.scroll-target {
                                    article-scroll.content-y = max(article-scroll.visible-height - article-scroll.content-height, -self.y - 10px);
                                }
                            }
                            Text {
                                text: section.title;
                                color: Theme.text;
                                font-size: section.level == 1 ? 25px : 18px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            StyledText {
                                width: parent.width;
                                height: self.preferred-height;
                                text: section.text;
                                default-color: Theme.text;
                                default-font-size: 14px;
                                link-color: Theme.accent-hover;
                                link-clicked(url) => { root.open-link(url); }
                            }
                        }
                    }
                }
            }
        }
    }
}
