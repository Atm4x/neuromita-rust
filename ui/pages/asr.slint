import { SettingsTheme } from "../settings/theme.slint";
import { SettingsText, SettingsGlyph, SettingsSectionHeading, SettingsTextField, SettingsToggle, SettingsCheckbox } from "../components/settings-kit.slint";
import { ActionSurface } from "../components/controls.slint";
import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";

component AsrMiddle inherits VerticalLayout {
    padding: 0px;
    spacing: 0px;
    alignment: center;
    @children
}


export global AsrUi {
    in-out property <bool> active;
    in-out property <bool> draft-enabled;
    in-out property <bool> runtime-ready;
    in-out property <[string]> recognizers;
    in-out property <string> recognizer;
    in-out property <[string]> devices;
    in-out property <string> device;
    in-out property <[string]> audio-backends;
    in-out property <string> audio-backend;
    in-out property <string> status;
    in-out property <bool> instant-send;
    in-out property <bool> delayed-send;
    in-out property <bool> merge-chat;
    in-out property <bool> pause-while-speaking;
    in-out property <string> send-delay;
    in-out property <[string]> input-modes;
    in-out property <string> input-mode;
    in-out property <[string]> languages;
    in-out property <string> language;
    in-out property <string> language-hint;
    in-out property <string> sample-rate;
    in-out property <string> chunk-size;
    in-out property <string> vad-threshold;
    in-out property <string> silence-timeout;
    in-out property <string> pre-buffer;
    in-out property <string> max-speech;
    in-out property <string> min-speech;
    in-out property <int> mic-level;
    in-out property <string> monitored-device;
    in-out property <bool> testing;
    callback persist();
    callback recognizer-changed(string);
    callback refresh-models();
    callback refresh-devices();
}

component AsrCard inherits Rectangle {
    background: SettingsTheme.panel;
    border-width: 1px;
    border-color: SettingsTheme.border;
    border-radius: 14px;
    @children
}

component AsrButton inherits ActionSurface {
    in property <string> title;
    in property <string> glyph;
    in property <bool> primary;
    label: root.title;
    height: 38px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.primary ? SettingsTheme.accent : SettingsTheme.button-border;
    background: root.primary ? SettingsTheme.accent : self.hovered ? SettingsTheme.button-hover : SettingsTheme.button;
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 7px; alignment: center;
        if root.glyph != "": SettingsGlyph { text: root.glyph; width: 16px; font-size: 13px; color: root.enabled ? SettingsTheme.text : SettingsTheme.muted; }
        if root.title != "": SettingsText {
            text: root.title; font-weight: 650; font-size: 12px;
            horizontal-alignment: center; color: root.enabled ? SettingsTheme.text : SettingsTheme.muted;
        }
    }
}

component AsrCardHeading inherits HorizontalLayout {
    in property <string> title;
    in property <string> glyph;
    height: 39px; spacing: 10px; vertical-stretch: 0;
    Rectangle { width: 38px; height: 38px; background: SettingsTheme.heading-icon-background; border-radius: 10px;
        SettingsGlyph { text: root.glyph; width: 100%; height: 100%; color: SettingsTheme.accent; font-size: 18px; }
    }
    SettingsText { text: root.title; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
}

component AsrSelect inherits Rectangle {
    in property <[string]> choices;
    in property <string> selected;
    in property <string> placeholder;
    in property <bool> available: true;
    callback chosen(string);
    height: 38px; min-width: 0px; preferred-width: 0px;
    background: SettingsTheme.field;
    border-color: SettingsTheme.field-border; border-width: 1px; border-radius: 9px;
    HorizontalLayout {
        padding-left: 11px; padding-right: 10px; spacing: 8px;
        SettingsText { text: root.selected == "" ? root.placeholder : root.selected; min-width: 0px; horizontal-stretch: 1; color: root.selected == "" ? SettingsTheme.muted : SettingsTheme.text; overflow: elide; }
        SettingsGlyph { text: "\u{f078}"; width: 14px; color: SettingsTheme.accent; font-size: 11px; }
    }
    TouchArea { enabled: root.available && root.choices.length > 0; mouse-cursor: pointer; clicked => { choices-popup.show(); } }
    choices-popup := PopupWindow {
        y: root.height + 3px; width: root.width; height: min(240px, root.choices.length * 36px + 8px);
        close-policy: close-on-click-outside;
        Rectangle { width: 100%; height: 100%; background: SettingsTheme.popup; border-color: SettingsTheme.border; border-width: 1px; border-radius: 9px;
            ScrollView {
                width: 100%; height: 100%; content-width: self.visible-width;
                VerticalLayout { padding: 4px; spacing: 2px; alignment: start;
                    for choice in root.choices: ActionSurface { label: choice; height: 32px; border-radius: 6px;
                        background: self.hovered ? SettingsTheme.button-hover : transparent;
                        HorizontalLayout { padding-left: 10px; SettingsText { text: choice; overflow: elide; min-width: 0px; } }
                        activated => { root.chosen(choice); choices-popup.close(); }
                    }
                }
            }
        }
    }
}

component AsrTopField inherits VerticalLayout {
    in property <string> title;
    spacing: 7px; padding: 0px; min-width: 0px;
    SettingsText { text: root.title; height: 18px; color: SettingsTheme.muted; font-size: 12px; }
    @children
}

component AsrStatus inherits Rectangle {
    height: 38px; min-width: 0px;
    background: SettingsTheme.field; border-width: 1px; border-color: SettingsTheme.border; border-radius: 9px;
    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
        AsrMiddle { width: 9px; height: 100%;
            Rectangle { width: 9px; height: 9px; border-radius: 5px; background: AsrUi.active && AsrUi.runtime-ready ? SettingsTheme.status-success : SettingsTheme.accent; }
        }
        SettingsText { text: AsrUi.status == "" ? I18n.i18n("asr.status.unavailable", "Распознавание не запущено") : AsrUi.status; color: SettingsTheme.muted; horizontal-stretch: 1; }
    }
}

component AsrToggleSetting inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> glyph;
    in property <bool> checked;
    callback changed(bool);
    height: 70px; vertical-stretch: 0; border-radius: 10px;
    border-width: 1px; border-color: SettingsTheme.border;
    background: SettingsTheme.section;
    HorizontalLayout { padding-left: 10px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
        AsrMiddle { width: 36px; height: 100%;
            Rectangle { width: 36px; height: 36px; border-radius: 10px; background: SettingsTheme.heading-icon-background;
                SettingsGlyph { text: root.glyph; width: 100%; height: 100%; font-size: 17px; color: SettingsTheme.accent; }
            }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 3px; alignment: center;
            SettingsText { text: root.title; font-size: 13px; font-weight: 600; wrap: word-wrap; overflow: clip; }
            SettingsText { text: root.hint; color: SettingsTheme.muted; font-size: 11px; wrap: word-wrap; overflow: clip; }
        }
        AsrMiddle { width: 20px; height: 100%;
            SettingsCheckbox { checked: root.checked; enabled: AsrUi.draft-enabled; toggled(value) => { root.changed(value); } }
        }
    }
}

component AsrParameter inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> glyph;
    in-out property <string> value;
    in property <bool> active: true;
    callback committed(string);
    height: 70px; vertical-stretch: 0; border-radius: 10px; border-width: 1px; border-color: SettingsTheme.border;
    background: SettingsTheme.section;
    HorizontalLayout { padding-left: 10px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
        AsrMiddle { width: 36px; height: 100%;
            Rectangle { width: 36px; height: 36px; border-radius: 10px; background: SettingsTheme.heading-icon-background;
                SettingsGlyph { text: root.glyph; width: 100%; height: 100%; font-size: 17px; color: SettingsTheme.accent; }
            }
        }
        VerticalLayout { spacing: 3px; alignment: center; horizontal-stretch: 1;
            SettingsText { text: root.title; font-size: 13px; font-weight: 600; wrap: word-wrap; overflow: clip; }
            SettingsText { text: root.hint; color: SettingsTheme.muted; font-size: 11px; wrap: word-wrap; overflow: clip; }
        }
        AsrMiddle { width: 110px; height: 100%;
            SettingsTextField { width: 110px; value <=> root.value; editable: root.active && AsrUi.draft-enabled; accepted(value) => { root.committed(value); } }
        }
    }
}

component AsrToolbar inherits AsrCard {
    VerticalLayout { padding: 15px; spacing: 12px;
        if root.width >= 850px: HorizontalLayout { height: 44px; spacing: 15px;
            HorizontalLayout { horizontal-stretch: 1; spacing: 12px;
                AsrMiddle { width: 42px; height: 100%;
                    SettingsToggle { checked: AsrUi.active; enabled: AsrUi.runtime-ready; toggled(v) => { AsrUi.active = v; } }
                }
                VerticalLayout { spacing: 2px; alignment: center;
                    SettingsText { text: I18n.i18n("asr.active", "Микрофон активен"); font-size: 13px; font-weight: 650; }
                    SettingsText { text: AsrUi.active ? I18n.i18n("asr.recognition.enabled", "Распознавание включено") : I18n.i18n("asr.recognition.disabled", "Распознавание выключено"); font-size: 11px; color: SettingsTheme.muted; }
                }
            }
            HorizontalLayout { horizontal-stretch: 2; spacing: 10px; alignment: end;
                SettingsText { text: I18n.i18n("asr.status", "Статус"); color: SettingsTheme.muted; }
                AsrStatus { horizontal-stretch: 1; }
                AsrButton { title: I18n.i18n("asr.restart", "Перезапустить"); glyph: "\u{f2f9}"; enabled: false; }
            }
        }
        if root.width < 850px: VerticalLayout { spacing: 10px;
            HorizontalLayout { spacing: 12px; height: 36px;
                AsrMiddle { width: 42px; height: 100%;
                    SettingsToggle { checked: AsrUi.active; enabled: AsrUi.runtime-ready; toggled(v) => { AsrUi.active = v; } }
                }
                SettingsText { text: I18n.i18n("asr.active", "Микрофон активен"); font-weight: 650; horizontal-stretch: 1; }
                SettingsText { text: AsrUi.active ? I18n.i18n("asr.recognition.enabled", "Распознавание включено") : I18n.i18n("asr.recognition.disabled", "Распознавание выключено"); color: SettingsTheme.muted; }
            }
            HorizontalLayout { spacing: 9px;
                AsrStatus { horizontal-stretch: 1; }
                AsrButton { title: I18n.i18n("asr.restart", "Перезапустить"); glyph: "\u{f2f9}"; enabled: false; }
            }
        }
        Rectangle { height: 1px; background: SettingsTheme.border; vertical-stretch: 0; }
        if root.width >= 850px: HorizontalLayout { spacing: 14px; vertical-stretch: 0;
            AsrTopField { horizontal-stretch: 3; title: I18n.i18n("asr.recognizer", "Модель распознавания");
                HorizontalLayout { spacing: 7px;
                    AsrSelect { horizontal-stretch: 1; choices: AsrUi.recognizers; selected: AsrUi.recognizer; placeholder: I18n.i18n("asr.models.empty", "Нет установленных моделей"); chosen(v) => { AsrUi.recognizer = v; AsrUi.recognizer-changed(v); } }
                    AsrButton { width: 38px; title: ""; glyph: "\u{f021}"; enabled: true; activated => { AsrUi.refresh-models(); } }
                    AsrButton { title: I18n.i18n("asr.catalog", "Каталог моделей"); glyph: "\u{f1b3}"; enabled: false; }
                }
            }
            AsrTopField { horizontal-stretch: 4; title: I18n.i18n("asr.input-device", "Устройство ввода");
                HorizontalLayout { spacing: 7px;
                    AsrSelect { horizontal-stretch: 1; choices: AsrUi.devices; selected: AsrUi.device; placeholder: I18n.i18n("asr.device.empty", "Нет доступных устройств"); chosen(v) => { AsrUi.device = v; AsrUi.persist(); } }
                    AsrButton { width: 38px; title: ""; glyph: "\u{f021}"; enabled: true; activated => { AsrUi.refresh-devices(); } }
                }
            }
            AsrTopField { horizontal-stretch: 2; title: I18n.i18n("asr.audio-backend", "Аудиобэкенд");
                AsrSelect { choices: AsrUi.audio-backends; selected: AsrUi.audio-backend; placeholder: "—"; chosen(v) => { AsrUi.audio-backend = v; AsrUi.persist(); } }
            }
        }
        if root.width < 850px: VerticalLayout { spacing: 12px;
            AsrTopField { title: I18n.i18n("asr.recognizer", "Модель распознавания");
                HorizontalLayout { spacing: 7px;
                    AsrSelect { horizontal-stretch: 1; choices: AsrUi.recognizers; selected: AsrUi.recognizer; placeholder: I18n.i18n("asr.models.empty", "Нет установленных моделей"); chosen(v) => { AsrUi.recognizer = v; AsrUi.recognizer-changed(v); } }
                    AsrButton { width: 38px; title: ""; glyph: "\u{f021}"; enabled: true; activated => { AsrUi.refresh-models(); } }
                    AsrButton { title: I18n.i18n("asr.catalog", "Каталог моделей"); glyph: "\u{f1b3}"; enabled: false; }
                }
            }
            AsrTopField { title: I18n.i18n("asr.input-device", "Устройство ввода");
                HorizontalLayout { spacing: 7px;
                    AsrSelect { horizontal-stretch: 1; choices: AsrUi.devices; selected: AsrUi.device; placeholder: I18n.i18n("asr.device.empty", "Нет доступных устройств"); chosen(v) => { AsrUi.device = v; AsrUi.persist(); } }
                    AsrButton { width: 38px; title: ""; glyph: "\u{f021}"; enabled: true; activated => { AsrUi.refresh-devices(); } }
                }
            }
            AsrTopField { title: I18n.i18n("asr.audio-backend", "Аудиобэкенд");
                AsrSelect { choices: AsrUi.audio-backends; selected: AsrUi.audio-backend; placeholder: "—"; chosen(v) => { AsrUi.audio-backend = v; AsrUi.persist(); } }
            }
        }
    }
}

component AsrBehaviorCard inherits AsrCard {
    VerticalLayout { padding: 15px; spacing: 10px; alignment: start;
        AsrCardHeading { title: I18n.i18n("asr.behavior", "Поведение и отправка"); glyph: "\u{f1de}"; }
        AsrToggleSetting { title: I18n.i18n("asr.instant", "Мгновенная отправка"); hint: I18n.i18n("asr.instant.note", "Отправлять распознанный текст сразу."); glyph: "\u{f0e7}"; checked: AsrUi.instant-send; changed(v) => { AsrUi.instant-send = v; AsrUi.persist(); } }
        AsrToggleSetting { title: I18n.i18n("asr.delay", "Отправлять с паузой"); hint: I18n.i18n("asr.delay.note", "Новая речь или печать перезапускает отсчёт."); glyph: "\u{f017}"; checked: AsrUi.delayed-send; changed(v) => { AsrUi.delayed-send = v; AsrUi.persist(); } }
        if AsrUi.delayed-send: AsrParameter { title: I18n.i18n("asr.pause", "Пауза до отправки"); hint: I18n.i18n("asr.pause.note", "В секундах"); glyph: "\u{f252}"; value <=> AsrUi.send-delay; committed(value) => { AsrUi.persist(); } }
        AsrToggleSetting { title: I18n.i18n("asr.merge-chat", "Добавлять текст из чата"); hint: I18n.i18n("asr.merge-chat.note", "Объединять речь с текстом в поле ввода."); glyph: "\u{f4ad}"; checked: AsrUi.merge-chat; changed(v) => { AsrUi.merge-chat = v; AsrUi.persist(); } }
        AsrToggleSetting { title: I18n.i18n("asr.pause-speaking", "Приостанавливать распознавание, пока Мита говорит"); hint: I18n.i18n("asr.pause-speaking.note", "Не распознавать речь во время ответа Миты."); glyph: "\u{f04c}"; checked: AsrUi.pause-while-speaking; changed(v) => { AsrUi.pause-while-speaking = v; AsrUi.persist(); } }
        Rectangle { height: 70px; border-radius: 10px; border-width: 1px; border-color: SettingsTheme.border; background: SettingsTheme.section; vertical-stretch: 0;
            HorizontalLayout { padding-left: 10px; padding-right: 12px; spacing: 10px;
                AsrMiddle { width: 36px; height: 100%;
                    Rectangle { width: 36px; height: 36px; border-radius: 10px; background: SettingsTheme.heading-icon-background;
                        SettingsGlyph { text: "\u{f11c}"; width: 100%; height: 100%; color: SettingsTheme.accent; font-size: 17px; }
                    }
                }
                VerticalLayout { spacing: 3px; alignment: center; horizontal-stretch: 1;
                    SettingsText { text: I18n.i18n("asr.input-mode", "Режим ввода"); font-size: 13px; font-weight: 600; }
                    SettingsText { text: I18n.i18n("asr.input-mode.note", "Способ активации распознавания речи."); font-size: 11px; color: SettingsTheme.muted; }
                }
                AsrMiddle { width: 215px; height: 100%;
                    AsrSelect { width: 215px; selected: AsrUi.input-mode; choices: AsrUi.input-modes; placeholder: "—"; chosen(v) => { AsrUi.input-mode = v; AsrUi.persist(); } }
                }
            }
        }
    }
}

component AsrRecognitionCard inherits AsrCard {
    VerticalLayout { padding: 15px; spacing: 10px; alignment: start;
        AsrCardHeading { title: I18n.i18n("asr.parameters", "Параметры распознавания"); glyph: "\u{f83e}"; }
        AsrTopField { title: I18n.i18n("asr.language", "Язык распознавания");
            AsrSelect { selected: AsrUi.language; choices: AsrUi.languages; placeholder: I18n.i18n("asr.language.choose", "Выберите модель распознавания"); chosen(v) => { AsrUi.language = v; AsrUi.persist(); } }
        }
        SettingsText { text: I18n.i18n("asr.language.note", "Язык сохраняется отдельно для каждой модели."); color: SettingsTheme.muted; font-size: 11px; height: 17px; }
        SettingsText { text: AsrUi.language-hint; color: SettingsTheme.muted; font-size: 11px; height: AsrUi.language-hint == "" ? 0px : 17px; }
        AsrParameter { title: I18n.i18n("asr.sample-rate", "Частота дискретизации"); hint: I18n.i18n("asr.sample-rate.note", "Фиксированная частота: 16000 Гц."); glyph: "\u{f83e}"; value: AsrUi.sample-rate; active: false; }
        AsrParameter { title: I18n.i18n("asr.chunk", "Размер чанка"); hint: I18n.i18n("asr.chunk.note", "Размер аудиоблока в сэмплах."); glyph: "\u{f1c0}"; value <=> AsrUi.chunk-size; committed(value) => { AsrUi.persist(); } }
        AsrParameter { title: I18n.i18n("asr.threshold", "Порог голосовой активности"); hint: I18n.i18n("asr.threshold.note", "Порог голосовой активности."); glyph: "\u{f83e}"; value <=> AsrUi.vad-threshold; committed(value) => { AsrUi.persist(); } }
        AsrParameter { title: I18n.i18n("asr.silence", "Тишина (сек)"); hint: I18n.i18n("asr.silence.note", "Пауза для окончания фразы. Менее 0,4 с может обрезать речь."); glyph: "\u{f017}"; value <=> AsrUi.silence-timeout; committed(value) => { AsrUi.persist(); } }
        AsrParameter { title: I18n.i18n("asr.pre-buffer", "Предбуфер (сек)"); hint: I18n.i18n("asr.pre-buffer.note", "Аудио до начала речи."); glyph: "\u{f04a}"; value <=> AsrUi.pre-buffer; committed(value) => { AsrUi.persist(); } }
        AsrParameter { title: I18n.i18n("asr.max-speech", "Макс. речь (сек)"); hint: I18n.i18n("asr.max-speech.note", "Максимальная длительность одной фразы."); glyph: "\u{f253}"; value <=> AsrUi.max-speech; committed(value) => { AsrUi.persist(); } }
        AsrParameter { title: I18n.i18n("asr.min-speech", "Мин. речь (сек)"); hint: I18n.i18n("asr.min-speech.note", "Отсеивать щелчки и короткие звуки. 0 — отключить."); glyph: "\u{f0b0}"; value <=> AsrUi.min-speech; committed(value) => { AsrUi.persist(); } }
        HorizontalLayout { height: 38px; spacing: 8px; vertical-stretch: 0;
            AsrButton { title: I18n.i18n("asr.apply", "Применить"); glyph: "\u{f00c}"; horizontal-stretch: 1; enabled: true; activated => { AsrUi.persist(); } }
            AsrButton { title: I18n.i18n("asr.reset", "Сбросить"); glyph: "\u{f0e2}"; horizontal-stretch: 1; enabled: false; }
        }
    }
}

component AsrMonitorCard inherits AsrCard {
    VerticalLayout { padding: 15px; spacing: 12px; alignment: start;
        HorizontalLayout { spacing: 12px; height: 50px; vertical-stretch: 0;
            Rectangle { width: 43px; height: 43px; border-radius: 12px; background: SettingsTheme.heading-icon-background;
                SettingsGlyph { text: "\u{f130}"; width: 100%; height: 100%; font-size: 22px; color: SettingsTheme.accent; }
            }
            VerticalLayout { spacing: 3px; alignment: center; horizontal-stretch: 1;
                SettingsText { text: I18n.i18n("asr.microphone-level", "Уровень микрофона"); font-size: 15px; font-weight: 700; }
                SettingsText { text: I18n.i18n("asr.monitor.note", "Во время теста вы слышите себя. Распознавание временно приостановлено."); color: SettingsTheme.muted; font-size: 11px; wrap: word-wrap; overflow: clip; }
            }
            AsrButton { title: AsrUi.testing ? I18n.i18n("asr.monitor.stop", "Остановить тест") : I18n.i18n("asr.monitor.start", "Проверить микрофон"); glyph: "\u{f025}"; enabled: false; }
        }
        Rectangle { height: 30px; background: SettingsTheme.field; border-width: 1px; border-color: SettingsTheme.field-border; border-radius: 8px;
            Rectangle { x: 4px; y: 4px; height: parent.height - 8px; width: max(0px, (parent.width - 8px) * AsrUi.mic-level / 100); border-radius: 5px; background: SettingsTheme.accent; }
        }
        SettingsText { text: AsrUi.monitored-device == "" ? I18n.i18n("asr.monitor.no-device", "Устройство для проверки не выбрано") : AsrUi.monitored-device; color: SettingsTheme.muted; font-size: 11px; height: 19px; }
    }
}

export component AsrSettingsPage inherits VerticalLayout {
    spacing: 14px; padding-left: 2px; padding-right: 10px; padding-top: 2px; padding-bottom: 2px; alignment: start;
    SettingsSectionHeading { title: I18n.i18n("asr.title", "Настройки микрофона"); description: I18n.i18n("asr.description", "Устройства ввода, распознавание речи и проверка микрофона."); glyph: "\u{f130}"; }
    AsrToolbar { vertical-stretch: 0; }
    if root.width >= 880px: HorizontalLayout { spacing: 14px; vertical-stretch: 0;
        AsrBehaviorCard { horizontal-stretch: 1; min-width: 0px; }
        AsrRecognitionCard { horizontal-stretch: 1; min-width: 0px; }
    }
    if root.width < 880px: VerticalLayout { spacing: 14px; vertical-stretch: 0;
        AsrBehaviorCard {}
        AsrRecognitionCard {}
    }
    AsrMonitorCard { vertical-stretch: 0; }
}
