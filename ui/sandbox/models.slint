export enum ChatStatus { history, pending, text, text-ready, voice, accepting, success, cancelled, text-error, voice-error, internal-error }
export struct ChatRow {
    text: string, detail: string, attachment-summary: string, request-id: string, user: bool, speaker: string, character-index: int,
    status: ChatStatus, can-cancel: bool, can-retry: bool, sequence: string, event-id: string, can-hide: bool,
    tool-name: string, tool-args: string, tool-json: string, tool-executing: bool,
}
